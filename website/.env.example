# Use unique production values and never commit the real .env file.
SESSION_SECRET=replace_with_at_least_32_random_characters

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_password

EDITOR_USERNAME=editor
EDITOR_PASSWORD=replace_with_a_different_strong_password

VIEWER_USERNAME=viewer
VIEWER_PASSWORD=replace_with_a_different_strong_password

# Set only when the deployment proxy overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Optional persistent, writable directory for production content.
# KRISM_CONTENT_DIR=/var/lib/krism/content

# Public recipient used by the privacy-preserving contact form. The form opens
# the visitor's email application and the website does not retain the message.
PUBLIC_CONTACT_EMAIL=contact@example.org
PUBLIC_CONTACT_PHONE=
PUBLIC_CONTACT_ADDRESS=
PUBLIC_WHATSAPP_URL=
PUBLIC_TELEGRAM_URL=
PUBLIC_LINKEDIN_URL=
PUBLIC_INSTAGRAM_URL=

# Private, writable storage for contact and event-registration submissions.
# Keep this directory outside the public web root and include it in encrypted backups.
# KRISM_SUBMISSIONS_DIR=/var/lib/krism/submissions
FORM_RETENTION_DAYS=90
