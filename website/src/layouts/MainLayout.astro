---
import "../styles/global.css";
import Header from "../components/HeaderV2.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  lang?: "en" | "fa";
  canonical?: string;
  ogImage?: string;
  robots?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = "KRISM — Khorasan Sleep Medicine",
  description = "Khorasan Representative of Iranian Sleep Medicine Societies",
  lang = "en",
  canonical,
  ogImage = "/images/krism-logo.png",
  robots = "index, follow",
  structuredData,
} = Astro.props;

const isPersian = lang === "fa";

const currentPath = Astro.url.pathname;
const siteOrigin = Astro.site ?? Astro.url.origin;
const canonicalUrl = canonical ? new URL(canonical, siteOrigin).href : new URL(currentPath, siteOrigin).href;

const englishPath =
  currentPath.startsWith("/fa")
    ? currentPath.replace(/^\/fa/, "") || "/"
    : currentPath;

const persianPath =
  currentPath.startsWith("/fa")
    ? currentPath
    : currentPath === "/"
      ? "/fa"
      : `/fa${currentPath}`;

const englishUrl =
  new URL(englishPath, siteOrigin).href;

const persianUrl =
  new URL(persianPath, siteOrigin).href;

const socialImageUrl = new URL(ogImage, siteOrigin).href;
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "KRISM — Khorasan Sleep Medicine",
  url: new URL("/", siteOrigin).href,
  logo: new URL("/images/krism-logo.png", siteOrigin).href,
  areaServed: "Khorasan, Iran",
};
const schemas = [organizationSchema, ...(Array.isArray(structuredData) ? structuredData : structuredData ? [structuredData] : [])];
---

<!doctype html>
<html lang={lang} dir={isPersian ? "rtl" : "ltr"}>

  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />

    <meta
      name="author"
      content="KRISM"
    />

    <meta
      name="theme-color"
      content="#0a2333"
    />

    <meta
      name="robots"
      content={robots}
    />

    <!-- Canonical -->
    <link
      rel="canonical"
      href={canonicalUrl}
    />

    <!-- Language alternatives -->
    <link
      rel="alternate"
      hreflang="en"
      href={englishUrl}
    />

    <link
      rel="alternate"
      hreflang="fa"
      href={persianUrl}
    />

    <link
      rel="alternate"
      hreflang="x-default"
      href={englishUrl}
    />

    <!-- Open Graph -->
    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:title"
      content={title}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:site_name"
      content="KRISM"
    />

    <meta
      property="og:url"
      content={canonicalUrl}
    />

    <meta
      property="og:locale"
      content={isPersian ? "fa_IR" : "en_US"}
    />

    <meta property="og:locale:alternate" content={isPersian ? "en_US" : "fa_IR"} />

    <meta
      property="og:image"
      content={socialImageUrl}
    />

    <!-- Twitter / social sharing -->
    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content={title}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    <meta
      name="twitter:image"
      content={socialImageUrl}
    />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Estedad:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link
      rel="icon"
      type="image/png"
      href="/images/krism-logo.png"
    />

    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}

  </head>

  <body class="font-sans">

    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-100 focus:rounded-lg focus:bg-white focus:px-4 focus:py-3 focus:text-sm focus:font-semibold focus:text-krism-900 focus:shadow-lg"
    >
      {isPersian
        ? "پرش به محتوای اصلی"
        : "Skip to main content"}
    </a>

    <Header />

    <main id="main-content" class="site-main">
      <slot />
    </main>

    <Footer />

  </body>
</html>
