---
import MainLayout from "../../layouts/MainLayout.astro";
import RecordHero from "../../components/RecordHero.astro";
import { researchProjects } from "../../data/research";

const project = researchProjects.find((item) => item.slug === Astro.params.slug);
if (!project) return Astro.rewrite("/404");
const projectMeta = [project.statusLabel && { label: "Status", value: project.statusLabel }, project.date && { label: "Started", value: project.date }, project.location && { label: "Location", value: project.location }].filter(Boolean) as Array<{ label: string; value: string }>;
const structuredData = { "@context": "https://schema.org", "@type": "ResearchProject", name: project.title, description: project.description, inLanguage: "en", funder: project.funding ? { "@type": "Organization", name: project.funding } : undefined, url: project.projectUrl || new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href };
---

<MainLayout
  title={`${project.title} — KRISM`}
  description={project.description}
  structuredData={structuredData}
>

  <RecordHero icon="research" eyebrow={project.type} title={project.title} description={project.description} meta={projectMeta} />


  <section class="mx-auto max-w-5xl px-6 py-16 lg:px-8">

    <div class="grid gap-12 lg:grid-cols-[1fr_280px]">

      <div>

        <h2 class="text-2xl font-semibold text-krism-950">
          About the project
        </h2>

        <p class="mt-5 text-base leading-8 text-krism-muted">
          {project.description ?? project.description}
        </p>

        {project.leadInvestigators?.length && <><h2 class="mt-12 text-2xl font-semibold text-krism-950">Lead investigators</h2><ul class="mt-5 space-y-2 text-base leading-8 text-krism-muted">{project.leadInvestigators.map((name) => <li>{name}</li>)}</ul></>}
        {project.collaborators?.length && <><h2 class="mt-12 text-2xl font-semibold text-krism-950">Collaborating institutions</h2><ul class="mt-5 space-y-2 text-base leading-8 text-krism-muted">{project.collaborators.map((name) => <li>{name}</li>)}</ul></>}

      </div>


      <aside class="content-card h-fit p-6">

        <div>
          <div class="text-xs font-semibold uppercase tracking-[0.15em] text-krism-600">
            Status
          </div>

          <div class="mt-2 text-sm font-medium text-krism-950">
            {project.statusLabel ?? "Current"}
          </div>
        </div>


        {project.date && <div class="mt-6">
          <div class="text-xs font-semibold uppercase tracking-[0.15em] text-krism-600">
            Year
          </div>

          <div class="mt-2 text-sm text-krism-muted">
            {project.date}
          </div>
        </div>}


        {
          project.ethicsReference && (
            <div class="mt-6">
              <div class="text-xs font-semibold uppercase tracking-[0.15em] text-krism-600">
                Ethics reference
              </div>

              <div class="mt-2 text-sm text-krism-muted">
                {project.ethicsReference}
              </div>
            </div>
          )
        }

        {project.projectUrl && <a href={project.projectUrl} target="_blank" rel="noopener noreferrer" class="card-action mt-7">Official project page →</a>}

      </aside>

    </div>

  </section>

</MainLayout>
