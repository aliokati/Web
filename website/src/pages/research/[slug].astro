---
import MainLayout from "../../layouts/MainLayout.astro";
import { researchProjects } from "../../data/research";

export function getStaticPaths() {
  return researchProjects.map((project) => ({
    params: {
      slug: project.slug,
    },
    props: {
      project,
    },
  }));
}

const { project } = Astro.props;
---

<MainLayout
  title={`${project.title} — KRISM`}
  description={project.description}
>

  <section class="border-b border-krism-border bg-white">
    <div class="mx-auto max-w-5xl px-6 py-20 lg:px-8 lg:py-24">

      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-krism-600">
        {project.type}
      </p>

      <h1 class="mt-5 text-4xl font-semibold tracking-tight text-krism-950 sm:text-5xl">
        {project.title}
      </h1>

      <p class="mt-6 max-w-3xl text-lg leading-8 text-krism-muted">
        {project.description}
      </p>

    </div>
  </section>


  <section class="mx-auto max-w-5xl px-6 py-16 lg:px-8">

    <div class="grid gap-12 lg:grid-cols-[1fr_280px]">

      <div>

        <h2 class="text-2xl font-semibold text-krism-950">
          About the project
        </h2>

        <p class="mt-5 text-base leading-8 text-krism-muted">
          {project.description ?? project.description}
        </p>

        <h2 class="mt-12 text-2xl font-semibold text-krism-950">
          Research collaboration
        </h2>

        <p class="mt-5 text-base leading-8 text-krism-muted">
          Further information about investigators, institutions,
          methodology, findings and opportunities for collaboration
          can be added here as the project develops.
        </p>

      </div>


      <aside class="h-fit rounded-2xl border border-krism-border bg-white p-6">

        <div>
          <div class="text-xs font-semibold uppercase tracking-[0.15em] text-krism-600">
            Status
          </div>

          <div class="mt-2 text-sm font-medium text-krism-950">
            {project.registrationOpen}
          </div>
        </div>


        <div class="mt-6">
          <div class="text-xs font-semibold uppercase tracking-[0.15em] text-krism-600">
            Year
          </div>

          <div class="mt-2 text-sm text-krism-muted">
            {project.date}
          </div>
        </div>


        {
          project.collaborators && (
            <div class="mt-6">
              <div class="text-xs font-semibold uppercase tracking-[0.15em] text-krism-600">
                collaborators
              </div>

              <div class="mt-2 text-sm text-krism-muted">
                {project.collaborators}
              </div>
            </div>
          )
        }

      </aside>

    </div>

  </section>

</MainLayout>