---
import MainLayout from "../../layouts/MainLayout.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import ResearchCard from "../../components/ResearchCard.astro";
import PublicationCard from "../../components/PublicationCard.astro";
import { researchProjects } from "../../data/research";
import { publications } from "../../data/publications";
import { resources } from "../../data/resources";

const featuredProjects = researchProjects.filter(
  (project) => project.featured
);
---

<MainLayout
  title="Research — KRISM"
  description="Sleep medicine research, collaboration and scientific activity through KRISM."
>

  <PageHero
    eyebrow="Research"
    title="Advancing sleep medicine through research and collaboration."
    description="KRISM supports research, scientific exchange and collaboration among professionals and institutions working in sleep medicine."
  />


  <section class="mx-auto max-w-7xl px-6 py-20 lg:px-8">

    <SectionHeader
      eyebrow="Featured"
      title="Research initiatives"
      description="Current and developing research initiatives within the KRISM community."
    />

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      {featuredProjects.map((project) => (
        <ResearchCard project={project} />
      ))}
    </div>

  </section>


  <section class="border-t border-krism-border bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">

      <SectionHeader
        eyebrow="Research portfolio"
        title="Explore research activities"
      />

      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {researchProjects.map((project) => (
          <ResearchCard project={project} />
        ))}
      </div>

    </div>
  </section>


  <section class="border-t border-krism-border">
    <div class="mx-auto max-w-4xl px-6 py-20 lg:px-8">

      <SectionHeader
        eyebrow="Publications"
        title="Scientific publications"
        description="Selected publications and scientific contributions associated with the KRISM research community."
      />

      <div class="mt-10">
        {resources.map((project) => (
          <PublicationCard resource={project} />
        ))}
      </div>

    </div>
  </section>


  <section class="bg-krism-950 text-white">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">

      <div class="max-w-3xl">

        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-krism-500">
          Collaboration
        </p>

        <h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">
          Research is stronger when communities connect.
        </h2>

        <p class="mt-5 text-base leading-7 text-slate-300">
          KRISM provides a platform for researchers and healthcare
          professionals to connect and develop scientific collaboration.
        </p>

        <a
          href="/contact"
          class="mt-8 inline-flex rounded-full bg-white px-6 py-3 text-sm font-semibold text-krism-950"
        >
          Discuss collaboration
        </a>

      </div>

    </div>
  </section>

</MainLayout>