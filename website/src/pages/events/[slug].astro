---
import MainLayout from "../../layouts/MainLayout.astro";
import RecordHero from "../../components/RecordHero.astro";
import { events } from "../../data/events";

const event = events.find((item) => item.slug === Astro.params.slug);
if (!event) return Astro.rewrite("/404");

const date = new Date(event.date);

const formattedDate = date.toLocaleDateString("en-US", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
});
const structuredData = { "@context": "https://schema.org", "@type": "Event", name: event.title, description: event.description, startDate: event.date, endDate: event.endDate, eventStatus: "https://schema.org/EventScheduled", eventAttendanceMode: "https://schema.org/MixedEventAttendanceMode", location: { "@type": "Place", name: event.location }, url: new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href };
const registrationHref = event.registrationMode === "external" && event.registrationUrl ? event.registrationUrl : `/events/${event.slug}/register`;
---

<MainLayout
  title={`${event.title} — KRISM`}
  description={event.description}
  structuredData={structuredData}
>

  <RecordHero icon="calendar" eyebrow={event.type} title={event.title} description={event.description} meta={[{label:"Date",value:formattedDate},{label:"Location",value:event.location},{label:"Access",value:event.registrationOpen ? "Registration open" : "Information"}]} />


  <section class="mx-auto max-w-5xl px-6 py-16 lg:px-8">

    <div class="grid gap-12 lg:grid-cols-[1fr_300px]">

      <div>
        <h2 class="text-2xl font-semibold text-krism-950">
          About this event
        </h2>

        <p class="mt-5 text-base leading-8 text-krism-muted">
          {event.description}
        </p>

        {event.registrationOpen && <p class="mt-6 text-base leading-8 text-krism-muted">Registration is currently open. Use the official registration link in the event information panel.</p>}
      </div>


      <aside class="content-card h-fit p-6">

        <p class="text-sm font-semibold text-krism-950">
          Event information
        </p>

        <div class="mt-5 space-y-4 text-sm text-krism-muted">

          <div>
            <div class="font-medium text-krism-950">Date</div>
            <div class="mt-1">{formattedDate}</div>
          </div>

          <div>
            <div class="font-medium text-krism-950">Location</div>
            <div class="mt-1">{event.location}</div>
          </div>

        </div>

        {
          event.registrationOpen && (
            <a
              href={registrationHref}
              target={event.registrationMode === "external" ? "_blank" : undefined}
              rel={event.registrationMode === "external" ? "noreferrer" : undefined}
              class="mt-7 block rounded-full bg-krism-900 px-5 py-3 text-center text-sm font-semibold text-white transition hover:bg-krism-800"
            >
              {event.registrationMode === "external" ? "Registration ↗" : "Register securely"}
            </a>
          )
        }

      </aside>

    </div>

  </section>

</MainLayout>
