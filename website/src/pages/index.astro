---
import MainLayout from "../layouts/MainLayout.astro";
import { events } from "../data/events";
import { researchProjects } from "../data/research";
import { awarenessArticles } from "../data/awareness";

const featuredEvents = events.filter((event) => event.featured).slice(0, 2);
const featuredResearch = researchProjects.filter((project) => project.featured).slice(0, 3);
const featuredAwareness = awarenessArticles.filter((article) => article.featured).slice(0, 3);

const pillars = [
  { number: "01", title: "Research", text: "Build meaningful evidence through regional studies and scientific collaboration.", href: "/research", color: "bg-[#dcebd9]" },
  { number: "02", title: "Education & Events", text: "Learn together through practical programs, meetings and professional exchange.", href: "/events", color: "bg-[#c9e5e7]" },
  { number: "03", title: "Sleep Awareness", text: "Make clear, responsible sleep-health information accessible to everyone.", href: "/awareness", color: "bg-[#edc1a8]" },
  { number: "04", title: "Professional Network", text: "Connect the people and institutions moving sleep medicine forward.", href: "/network", color: "bg-[#f5d86e]" },
];
---

<MainLayout
  title="KRISM — Khorasan Representative of Iranian Sleep Medicine Societies"
  description="KRISM connects research, education, public awareness and professional collaboration in sleep medicine across Khorasan."
>
  <section class="overflow-hidden bg-krism-950 text-white">
    <div class="mx-auto grid max-w-[1440px] lg:min-h-[690px] lg:grid-cols-[1.02fr_.98fr]">
      <div class="flex items-center px-6 py-20 lg:px-10 lg:py-24 xl:px-20">
        <div class="max-w-2xl">
          <p class="eyebrow text-[#f5d86e]">Khorasan Sleep Medicine</p>
          <h1 class="mt-8 text-5xl font-medium leading-[.95] tracking-[-.05em] sm:text-6xl lg:text-7xl xl:text-[5.5rem]">
            Evidence-led care for <em class="font-normal text-[#c9e5e7]">better sleep.</em>
          </h1>
          <p class="mt-8 max-w-xl text-base leading-8 text-white/70 sm:text-lg">
            Bringing researchers, clinicians and communities together to advance sleep medicine across the Khorasan region.
          </p>
          <div class="mt-10 flex flex-col gap-3 sm:flex-row">
            <a href="/research" class="rounded-full bg-[#f5d86e] px-7 py-3.5 text-center text-sm font-bold text-krism-950 transition hover:-translate-y-0.5 hover:bg-white">
              Explore our work
            </a>
            <a href="/contact" class="rounded-full border border-white/35 px-7 py-3.5 text-center text-sm font-bold text-white transition hover:-translate-y-0.5 hover:bg-white hover:text-krism-950">
              Connect with KRISM
            </a>
          </div>
          <div class="mt-12 flex flex-wrap gap-x-8 gap-y-4 border-t border-white/15 pt-7 text-xs font-semibold text-white/65">
            <span>Research-led</span><span>Community-focused</span><span>Bilingual access</span>
          </div>
        </div>
      </div>

      <div class="p-4 pt-0 lg:p-5 lg:pl-0">
        <div class="hero-art h-full min-h-[32rem] lg:min-h-[650px]">
          <div class="hero-logo-disc">
            <img src="/images/krism-logo.png" alt="KRISM Society emblem" />
          </div>
          <div class="absolute left-5 top-5 rounded-full bg-white/90 px-4 py-2 text-xs font-bold text-krism-950 shadow-lg backdrop-blur">
            Science · Education · Community
          </div>
          <div class="absolute bottom-5 right-5 max-w-[13rem] rounded-2xl bg-krism-950 p-4 text-white shadow-xl">
            <p class="text-2xl font-medium">Sleep shapes health.</p>
            <p class="mt-2 text-xs leading-5 text-white/65">We bring the region’s expertise into one connected platform.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="overflow-hidden border-b border-krism-950/10 bg-[#f5d86e] py-4 text-krism-950" aria-label="KRISM focus areas">
    <div class="marquee-track flex w-max items-center gap-7 whitespace-nowrap text-xs font-bold uppercase tracking-[.14em]">
      {[0, 1].map(() => (
        <>
          <span>Sleep science</span><span>✦</span><span>Clinical education</span><span>✦</span>
          <span>Public health</span><span>✦</span><span>Regional collaboration</span><span>✦</span>
          <span>Evidence-based care</span><span>✦</span><span>Professional community</span><span>✦</span>
        </>
      ))}
    </div>
  </section>

  <section class="bg-[#fbf9f4]">
    <div class="mx-auto max-w-[1440px] px-6 py-24 lg:px-10 lg:py-32">
      <div class="grid gap-12 lg:grid-cols-[.72fr_1.28fr] lg:items-start">
        <p class="eyebrow text-krism-600">What we do</p>
        <div>
          <h2 class="max-w-4xl text-4xl font-medium leading-[1.02] tracking-[-.04em] text-krism-950 sm:text-5xl lg:text-6xl">
            Sleep medicine designed to be <em class="font-normal text-krism-600">connected</em> and proven.
          </h2>
          <p class="mt-7 max-w-2xl text-base leading-8 text-krism-muted sm:text-lg">
            KRISM is a regional home for the people improving how sleep conditions are understood, studied and treated. We turn separate efforts into shared progress.
          </p>
        </div>
      </div>

      <div class="mt-16 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        {pillars.map((pillar) => (
          <a href={pillar.href} class:list={["group flex min-h-[21rem] flex-col rounded-[1.75rem] p-7 transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-krism-950/10", pillar.color]}>
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold tracking-[.16em] text-krism-950/55">{pillar.number}</span>
              <span class="flex h-10 w-10 items-center justify-center rounded-full border border-krism-950/20 text-lg transition group-hover:bg-krism-950 group-hover:text-white">↗</span>
            </div>
            <div class="mt-auto">
              <h3 class="text-3xl font-medium leading-none text-krism-950">{pillar.title}</h3>
              <p class="mt-5 text-sm leading-7 text-krism-950/70">{pillar.text}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-krism-950 text-white">
    <div class="mx-auto max-w-[1440px] px-6 py-24 lg:px-10 lg:py-32">
      <div class="max-w-4xl">
        <p class="eyebrow text-[#f5d86e]">One connected platform</p>
        <h2 class="mt-7 text-4xl font-medium leading-[1] tracking-[-.04em] sm:text-5xl lg:text-6xl">
          Knowledge, people and progress—all in one place.
        </h2>
      </div>

      <div class="mt-14 grid gap-4 lg:grid-cols-12">
        <div class="relative min-h-[25rem] overflow-hidden rounded-[2rem] bg-[#c9e5e7] p-8 text-krism-950 lg:col-span-7">
          <p class="text-xs font-bold uppercase tracking-[.15em]">Regional intelligence</p>
          <h3 class="mt-5 max-w-xl text-4xl font-medium leading-tight">Research that responds to the communities we serve.</h3>
          <p class="mt-5 max-w-lg text-sm leading-7 text-krism-950/70">A shared space for studies, collaborations and evidence that advances sleep medicine in Khorasan.</p>
          <div class="absolute -bottom-20 -right-16 h-72 w-72 rounded-full border-[44px] border-krism-950/10"></div>
          <a href="/research" class="absolute bottom-8 left-8 text-sm font-bold">Explore research →</a>
        </div>

        <div class="flex min-h-[25rem] flex-col rounded-[2rem] bg-[#edc1a8] p-8 text-krism-950 lg:col-span-5">
          <div class="flex h-14 w-14 items-center justify-center rounded-full bg-krism-950 text-2xl text-white">◎</div>
          <div class="mt-auto">
            <p class="text-6xl font-medium tracking-[-.06em]">4</p>
            <h3 class="mt-2 text-3xl font-medium">paths to impact</h3>
            <p class="mt-4 text-sm leading-7 text-krism-950/70">Research, education, awareness and a professional network—working together.</p>
          </div>
        </div>

        <div class="rounded-[2rem] bg-[#dcebd9] p-8 text-krism-950 lg:col-span-4">
          <p class="text-5xl font-medium tracking-[-.05em]">24/7</p>
          <h3 class="mt-4 text-2xl font-medium">Sleep affects every hour</h3>
          <p class="mt-4 text-sm leading-7 text-krism-950/65">Our public resources make better sleep knowledge easier to find and understand.</p>
        </div>
        <div class="rounded-[2rem] border border-white/15 bg-white/5 p-8 lg:col-span-8">
          <p class="text-xs font-bold uppercase tracking-[.15em] text-[#f5d86e]">Built for collaboration</p>
          <div class="mt-8 grid gap-7 sm:grid-cols-3">
            {[["Clinicians", "Share practice and expertise"], ["Researchers", "Find partners and opportunities"], ["Institutions", "Build stronger regional programs"]].map(([title, text]) => (
              <div class="border-l border-white/20 pl-5">
                <h3 class="text-2xl font-medium">{title}</h3>
                <p class="mt-3 text-sm leading-6 text-white/60">{text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#f6f1e9]">
    <div class="mx-auto max-w-[1440px] px-6 py-24 lg:px-10 lg:py-32">
      <div class="flex flex-col justify-between gap-7 sm:flex-row sm:items-end">
        <div>
          <p class="eyebrow text-krism-600">Current work</p>
          <h2 class="mt-6 max-w-3xl text-4xl font-medium leading-[1.04] tracking-[-.04em] text-krism-950 sm:text-5xl">Research with regional relevance.</h2>
        </div>
        <a href="/research" class="w-fit rounded-full border border-krism-950/20 px-6 py-3 text-sm font-bold text-krism-950 transition hover:bg-krism-950 hover:text-white">All research →</a>
      </div>

      <div class="mt-12 grid gap-4 lg:grid-cols-3">
        {featuredResearch.map((project, index) => (
          <a href={`/research/${project.slug}`} class="group soft-card flex min-h-[22rem] flex-col p-7 transition duration-300 hover:-translate-y-1">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-[.14em] text-krism-600">{project.type}</span>
              <span class="text-xs text-krism-muted">0{index + 1}</span>
            </div>
            <div class="mt-auto">
              <h3 class="text-3xl font-medium leading-[1.06] text-krism-950 transition group-hover:text-krism-600">{project.title}</h3>
              <p class="mt-5 text-sm leading-7 text-krism-muted">{project.description}</p>
              <p class="mt-6 text-sm font-bold text-krism-600">View project →</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#fbf9f4]">
    <div class="mx-auto grid max-w-[1440px] gap-14 px-6 py-24 lg:grid-cols-[.78fr_1.22fr] lg:px-10 lg:py-32">
      <div>
        <p class="eyebrow text-krism-600">Education & events</p>
        <h2 class="mt-6 text-4xl font-medium leading-[1.04] tracking-[-.04em] text-krism-950 sm:text-5xl">Meet. Learn. Move the field forward.</h2>
        <p class="mt-6 max-w-md text-base leading-8 text-krism-muted">Discover scientific meetings and learning opportunities created for the sleep-medicine community.</p>
        <a href="/events" class="mt-8 inline-flex rounded-full bg-krism-950 px-6 py-3 text-sm font-bold text-white transition hover:bg-krism-700">View all events</a>
      </div>
      <div class="divide-y divide-krism-950/15 border-y border-krism-950/15">
        {featuredEvents.map((event) => (
          <a href={`/events/${event.slug}`} class="group grid gap-4 py-7 sm:grid-cols-[9rem_1fr_auto] sm:items-center">
            <div class="text-xs font-bold uppercase tracking-[.12em] text-krism-600">{event.date}</div>
            <div>
              <h3 class="text-2xl font-medium leading-tight text-krism-950 group-hover:text-krism-600">{event.title}</h3>
              <p class="mt-2 text-sm text-krism-muted">{event.location}</p>
            </div>
            <span class="flex h-11 w-11 items-center justify-center rounded-full border border-krism-950/20 transition group-hover:bg-krism-950 group-hover:text-white">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#c9e5e7]">
    <div class="mx-auto max-w-[1440px] px-6 py-24 lg:px-10 lg:py-32">
      <div class="grid gap-12 lg:grid-cols-[.75fr_1.25fr]">
        <div>
          <p class="eyebrow text-krism-700">Sleep awareness</p>
          <h2 class="mt-6 text-4xl font-medium leading-[1.04] tracking-[-.04em] text-krism-950 sm:text-5xl">Clear answers for healthier nights.</h2>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          {featuredAwareness.map((article) => (
            <a href={`/awareness/${article.slug}`} class="group flex min-h-[20rem] flex-col rounded-[1.5rem] bg-white/70 p-6 transition hover:-translate-y-1 hover:bg-white">
              <p class="text-xs font-bold uppercase tracking-[.14em] text-krism-600">{article.category}</p>
              <div class="mt-auto">
                <h3 class="text-2xl font-medium leading-tight text-krism-950">{article.title}</h3>
                <p class="mt-4 text-sm leading-6 text-krism-muted">{article.excerpt}</p>
                <p class="mt-5 text-sm font-bold text-krism-600">Read article →</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#edc1a8] text-krism-950">
    <div class="mx-auto max-w-[1440px] px-6 py-24 text-center lg:px-10 lg:py-32">
      <p class="eyebrow justify-center text-krism-700">Collaboration starts here</p>
      <h2 class="mx-auto mt-7 max-w-4xl text-5xl font-medium leading-[.98] tracking-[-.045em] sm:text-6xl lg:text-7xl">Help shape the future of sleep medicine.</h2>
      <p class="mx-auto mt-7 max-w-2xl text-base leading-8 text-krism-950/70">We welcome clinicians, researchers, institutions and organizations ready to create meaningful regional impact.</p>
      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/contact" class="rounded-full bg-krism-950 px-7 py-3.5 text-sm font-bold text-white transition hover:-translate-y-0.5 hover:bg-krism-700">Contact KRISM</a>
        <a href="/network" class="rounded-full border border-krism-950/25 px-7 py-3.5 text-sm font-bold transition hover:-translate-y-0.5 hover:bg-white/50">Explore the network</a>
      </div>
    </div>
  </section>
</MainLayout>
