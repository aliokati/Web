---
import "../../styles/global.css";
import "../../styles/admin.css";
import { listSubmissions } from "../../lib/submission-store";
const user = Astro.locals.user!;
if (user.role !== "admin") return Astro.redirect("/admin/content-manager", 303);
const items = await listSubmissions();
const contactCount = items.filter((item) => item.kind === "contact").length;
const registrationCount = items.filter((item) => item.kind === "event-registration").length;
---

<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="robots" content="noindex,nofollow" /><title>Submissions — KRISM</title></head><body class="admin-shell"><header class="admin-topbar"><div class="flex items-center gap-3"><img src="/images/krism-logo.png" alt="" class="h-10 w-10 rounded-full" /><div><p class="text-sm font-bold">KRISM</p><p class="mt-1 text-[10px] uppercase tracking-[.13em] text-white/50">Form submissions</p></div></div><div class="flex items-center gap-3"><a href="/admin/content-manager" class="text-xs font-semibold text-white/70 hover:text-white">Content manager</a><span class="admin-pill">admin</span></div></header><main class="min-h-screen bg-[#f4f1e9] px-5 py-10 lg:px-10"><div class="mx-auto max-w-7xl"><div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end"><div><p class="text-xs font-bold uppercase tracking-[.14em] text-krism-600">PRIVATE ADMINISTRATION</p><h1 class="mt-3 text-4xl font-medium text-krism-950">Submissions</h1><p class="mt-3 text-sm text-krism-muted">{contactCount} contact inquiries · {registrationCount} event registrations</p></div><a href="/api/admin/submissions.csv" class="admin-button admin-button-primary">Download CSV</a></div><div class="mt-9 space-y-4">{items.length ? items.map((item) => <article class="rounded-2xl border border-krism-border bg-white p-6" data-submission={item.id}><div class="flex flex-col justify-between gap-4 border-b border-krism-border pb-5 sm:flex-row sm:items-start"><div><p class="text-xs font-bold uppercase tracking-[.12em] text-krism-600">{item.kind}{item.eventSlug ? ` · ${item.eventSlug}` : ""}</p><p class="mt-2 font-mono text-xs text-krism-muted">{new Date(item.createdAt).toLocaleString()} · {item.id}</p></div><button type="button" class="delete-submission admin-button admin-button-danger" data-id={item.id}>Delete</button></div><dl class="mt-5 grid gap-5 md:grid-cols-2">{Object.entries(item.data).map(([key,value]) => <div class:list={[key === "message" || key === "accessibility" ? "md:col-span-2" : ""]}><dt class="text-[10px] font-bold uppercase tracking-[.12em] text-krism-muted">{key}</dt><dd class="mt-2 whitespace-pre-wrap text-sm leading-7 text-krism-950">{String(value)}</dd></div>)}</dl></article>) : <div class="rounded-2xl border border-dashed border-krism-border bg-white p-12 text-center"><h2 class="text-2xl font-medium text-krism-950">No submissions yet</h2><p class="mt-3 text-sm text-krism-muted">New contact inquiries and internal event registrations will appear here.</p></div>}</div><p class="mt-8 max-w-3xl text-xs leading-6 text-krism-muted">Submissions contain personal data. Export only when necessary, store exports securely, and delete records when no longer needed. Automatic retention uses FORM_RETENTION_DAYS.</p></div></main><script>document.querySelectorAll<HTMLButtonElement>(".delete-submission").forEach((button)=>button.addEventListener("click",async()=>{if(!confirm("Permanently delete this submission?"))return;button.disabled=true;const response=await fetch(`/api/admin/submissions/${encodeURIComponent(button.dataset.id||"")}`,{method:"DELETE"});if(response.ok)button.closest("[data-submission]")?.remove();else{button.disabled=false;alert("Delete failed.");}}));</script></body></html>
