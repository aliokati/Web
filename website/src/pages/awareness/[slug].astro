---
import MainLayout from "../../layouts/MainLayout.astro";
import RecordHero from "../../components/RecordHero.astro";
import { awarenessArticles } from "../../data/awareness";

const article = awarenessArticles.find((item) => item.slug === Astro.params.slug);
if (!article) return Astro.rewrite("/404");
const structuredData = { "@context": "https://schema.org", "@type": "Article", headline: article.title, description: article.excerpt, inLanguage: "en", dateModified: article.reviewedAt, author: { "@type": "Organization", name: article.author || "KRISM" }, publisher: { "@type": "Organization", name: "KRISM" } };
---

<MainLayout
  title={`${article.title} — KRISM`}
  description={article.excerpt}
  structuredData={structuredData}
>
  <RecordHero icon="moon" eyebrow={article.category} title={article.title} description={article.excerpt} meta={[{label:"Format",value:"Public education"},{label:"Reading",value:"Evidence-led"},{label:"Language",value:"EN / FA"}]} />

  <article class="bg-white">
    <div class="mx-auto max-w-3xl px-6 py-16 lg:px-8 lg:py-20">
      <div class="space-y-7">
        {article.content.map((paragraph) => (
          <p class="text-base leading-8 text-krism-text">
            {paragraph}
          </p>
        ))}
      </div>

      <div class="mt-14 border-t border-krism-border pt-8">
        <p class="text-sm leading-7 text-krism-muted">
          This article is provided for general educational purposes and does
          not constitute individual medical advice.
        </p>

        <a
          href="/awareness"
          class="mt-6 inline-block text-sm font-semibold text-krism-600 hover:text-krism-900"
        >
          ← Back to Sleep Awareness
        </a>
      </div>
    </div>
  </article>
</MainLayout>
