---
import MainLayout from "../layouts/MainLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
---

<MainLayout
  title="About KRISM — Khorasan Sleep Medicine"
  description="Learn about KRISM, its mission, activities and role in advancing sleep medicine across Khorasan."
>
  <section class="border-b border-krism-border bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8 lg:py-24">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-krism-600">
        About KRISM
      </p>

      <h1 class="mt-5 max-w-4xl text-4xl font-semibold tracking-tight text-krism-950 sm:text-5xl lg:text-6xl">
        Connecting sleep medicine across Khorasan
      </h1>

      <p class="mt-6 max-w-3xl text-lg leading-8 text-krism-muted">
        The Khorasan Representative of Iranian Sleep Medicine Societies
        provides a regional platform for research, education, professional
        collaboration and public awareness in sleep medicine.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
      <SectionHeader
        eyebrow="Who we are"
        title="A regional platform for sleep medicine"
        description="KRISM brings together professionals, researchers, institutions and organizations interested in advancing sleep medicine throughout the Khorasan region."
      />

      <div class="mt-14 grid gap-6 md:grid-cols-2">
        <div class="rounded-2xl border border-krism-border bg-krism-surface p-8">
          <h2 class="text-xl font-semibold text-krism-950">
            Research
          </h2>

          <p class="mt-4 text-sm leading-7 text-krism-muted">
            Supporting scientific collaboration, research networks and
            development of sleep-medicine research activities.
          </p>
        </div>

        <div class="rounded-2xl border border-krism-border bg-krism-surface p-8">
          <h2 class="text-xl font-semibold text-krism-950">
            Education
          </h2>

          <p class="mt-4 text-sm leading-7 text-krism-muted">
            Facilitating scientific meetings, educational events and
            professional learning opportunities.
          </p>
        </div>

        <div class="rounded-2xl border border-krism-border bg-krism-surface p-8">
          <h2 class="text-xl font-semibold text-krism-950">
            Awareness
          </h2>

          <p class="mt-4 text-sm leading-7 text-krism-muted">
            Promoting accurate public understanding of sleep health and
            sleep-related disorders.
          </p>
        </div>

        <div class="rounded-2xl border border-krism-border bg-krism-surface p-8">
          <h2 class="text-xl font-semibold text-krism-950">
            Collaboration
          </h2>

          <p class="mt-4 text-sm leading-7 text-krism-muted">
            Connecting medical professionals, researchers, organizations and
            institutions working in or alongside sleep medicine.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-krism-surface">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
      <div class="grid gap-14 lg:grid-cols-2">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-krism-600">
            Mission
          </p>

          <h2 class="mt-4 text-3xl font-semibold tracking-tight text-krism-950">
            Strengthening the sleep medicine community
          </h2>

          <p class="mt-5 text-base leading-8 text-krism-muted">
            KRISM seeks to facilitate communication and collaboration among
            people and organizations involved in sleep medicine while
            supporting research, education and public awareness.
          </p>
        </div>

        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-krism-600">
            Vision
          </p>

          <h2 class="mt-4 text-3xl font-semibold tracking-tight text-krism-950">
            A connected regional sleep medicine community
          </h2>

          <p class="mt-5 text-base leading-8 text-krism-muted">
            The long-term aim is to contribute to a stronger regional network
            in which professionals, researchers and organizations can share
            knowledge, develop collaborations and improve awareness of sleep
            health.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-krism-950 text-white">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-300">
          Get involved
        </p>

        <h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">
          Interested in collaboration?
        </h2>

        <p class="mt-5 text-base leading-8 text-slate-300">
          KRISM welcomes opportunities for scientific, educational and
          organizational collaboration related to sleep medicine.
        </p>

        <a
          href="/contact"
          class="mt-8 inline-flex rounded-full bg-white px-6 py-3 text-sm font-semibold text-krism-950 transition hover:bg-slate-100"
        >
          Contact KRISM →
        </a>
      </div>
    </div>
  </section>
</MainLayout>