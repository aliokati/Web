---
import MainLayout from "../../../layouts/MainLayout.astro";
import RecordHero from "../../../components/RecordHero.astro";
import { awarenessArticlesFa as awarenessArticles } from "../../../data/awareness";

const slug = Astro.params.slug ?? "";
const article = awarenessArticles.find((item) => item.slug === slug);
if (!article) return Astro.rewrite("/404");
const structuredData = { "@context": "https://schema.org", "@type": "Article", headline: article.title, description: article.excerpt, inLanguage: "fa", dateModified: article.reviewedAt, author: { "@type": "Organization", name: article.author || "KRISM" }, publisher: { "@type": "Organization", name: "KRISM" } };
---

<MainLayout
  lang="fa"
  title={`${article.title} — KRISM`}
  description={article.excerpt}
  structuredData={structuredData}
>
  {
    article ? (
      <>
        <RecordHero icon="moon" eyebrow={article.category} title={article.title} description={article.excerpt} meta={[{label:"قالب",value:"آموزش عمومی"},{label:"رویکرد",value:"مبتنی بر شواهد"},{label:"زبان",value:"FA / EN"}]} />

        <article class="bg-white">
          <div class="mx-auto max-w-3xl px-6 py-16 lg:px-8 lg:py-20">

            <div class="space-y-7">
              {article.content.map((paragraph) => (
                <p class="text-base leading-9 text-krism-text">
                  {paragraph}
                </p>
              ))}
            </div>

            <div class="mt-14 border-t border-krism-border pt-8">

              <p class="text-sm leading-8 text-krism-muted">
                این مطلب صرفاً برای آموزش عمومی ارائه شده و جایگزین ارزیابی
                یا مشاوره پزشکی فردی نیست.
              </p>

              <a
                href="/fa/awareness"
                class="mt-6 inline-block text-sm font-semibold text-krism-600 hover:text-krism-900"
              >
                ← بازگشت به آگاهی‌رسانی درباره خواب
              </a>

            </div>

          </div>
        </article>
      </>
    ) : (
      <section class="bg-white">
        <div class="mx-auto max-w-4xl px-6 py-24 text-center lg:px-8">
          <h1 class="text-3xl font-semibold text-krism-950">
            مطلب مورد نظر پیدا نشد
          </h1>

          <a
            href="/fa/awareness"
            class="mt-6 inline-block text-sm font-semibold text-krism-600"
          >
            بازگشت
          </a>
        </div>
      </section>
    )
  }
</MainLayout>
