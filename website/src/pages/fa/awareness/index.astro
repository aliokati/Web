---
import MainLayout from "../../../layouts/MainLayout.astro";
import { awarenessArticlesFa as awarenessArticles } from "../../../data/awareness";
import PageHero from "../../../components/PageHero.astro";
---

<MainLayout
  lang="fa"
  title="آگاهی‌رسانی درباره خواب — KRISM"
  description="اطلاعات آموزشی عمومی درباره سلامت خواب و اختلالات خواب"
>
  <PageHero eyebrow="آگاهی‌رسانی درباره خواب" icon="clinical" title="شناخت بهتر خواب و سلامت خواب" description="مطالب آموزشی عمومی درباره خواب سالم، مشکلات شایع خواب و زمان مناسب برای مراجعه به متخصص." />

  <section class="bg-krism-surface">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">

      <div class="max-w-2xl">
        <p class="text-sm font-semibold text-krism-600">
          آموزش عمومی
        </p>

        <h2 class="mt-4 text-3xl font-semibold text-krism-950">
          اطلاعات سلامت خواب
        </h2>

        <p class="mt-5 text-base leading-8 text-krism-muted">
          هدف KRISM کمک به افزایش آگاهی عمومی و دسترسی به اطلاعات معتبر
          درباره اهمیت خواب و سلامت خواب است.
        </p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">

        {awarenessArticles.map((article) => {
          return (
            <a
              href={`/fa/awareness/${article.slug}`}
              class="group block rounded-2xl border border-krism-border bg-white p-7 transition hover:-translate-y-1 hover:border-krism-500 hover:shadow-lg"
            >
              <p class="text-xs font-semibold text-krism-600">
                {article.category}
              </p>

              <h2 class="mt-6 text-xl font-semibold text-krism-950">
                {article.title}
              </h2>

              <p class="mt-4 text-sm leading-8 text-krism-muted">
                {article.excerpt}
              </p>

              <div class="mt-7 text-sm font-semibold text-krism-600">
                مطالعه مطلب ←
              </div>
            </a>
          );
        })}

      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-4xl px-6 py-20 lg:px-8">

      <div class="rounded-2xl border border-krism-border bg-krism-surface p-8 lg:p-10">

        <p class="text-sm font-semibold text-krism-600">
          توجه
        </p>

        <h2 class="mt-4 text-2xl font-semibold text-krism-950">
          مطالب آموزشی جایگزین ارزیابی پزشکی نیستند
        </h2>

        <p class="mt-4 text-base leading-8 text-krism-muted">
          اطلاعات این بخش با هدف آموزش عمومی ارائه می‌شوند و جایگزین
          تشخیص، ارزیابی یا درمان توسط پزشک یا متخصص واجد شرایط نیستند.
        </p>

      </div>

    </div>
  </section>
</MainLayout>
