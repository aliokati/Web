---
import MainLayout from "../../layouts/MainLayout.astro";
import PageHero from "../../components/PageHero.astro";
import NetworkCard from "../../components/NetworkCard.astro";
import { networkMembersFa as networkMembers } from "../../data/network";

const members = networkMembers;
---

<MainLayout
  lang="fa"
  title="شبکه — KRISM"
  description="شبکه متخصصان، پژوهشگران، مؤسسات و سازمان‌های مرتبط با پزشکی خواب"
>
  <PageHero eyebrow="شبکه" icon="network" title="شبکه پزشکی خواب در خراسان" description="بستری برای معرفی و ارتباط متخصصان، پژوهشگران، مؤسسات و سازمان‌های فعال در حوزه پزشکی خواب." />

  <section class="bg-krism-surface">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">

        {members.length ? members.map((member) => <NetworkCard member={member} lang="fa" />) : <div class="md:col-span-2 lg:col-span-3 rounded-2xl border border-dashed border-krism-border bg-white/80 p-10 text-center"><p class="font-semibold text-krism-950">فهرست عمومی تأییدشده در حال آماده‌سازی است.</p><p class="mt-3 text-sm leading-8 text-krism-muted">نمایه‌ها تنها با تأیید فرد یا مؤسسه مربوط منتشر می‌شوند.</p></div>}

      </div>

      <div class="mt-16 rounded-2xl bg-krism-950 p-8 text-white lg:p-12">

        <p class="text-sm font-semibold text-slate-300">
          عضویت در شبکه
        </p>

        <h2 class="mt-4 text-3xl font-semibold">
          علاقه‌مند به همکاری با شبکه KRISM هستید؟
        </h2>

        <p class="mt-5 max-w-2xl text-base leading-8 text-slate-300">
          متخصصان، پژوهشگران، مؤسسات و سازمان‌های مرتبط می‌توانند برای
          همکاری و ارتباط با KRISM تماس بگیرند.
        </p>

        <a
          href="/fa/contact"
          class="mt-8 inline-flex rounded-full bg-white px-6 py-3 text-sm font-semibold text-krism-950"
        >
          تماس با KRISM ←
        </a>

      </div>
    </div>
  </section>
</MainLayout>
