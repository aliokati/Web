---
import MainLayout from "../../layouts/MainLayout.astro";
import { networkMembers } from "../../data/network";

const typeLabels: Record<string, string> = {
  Professional: "متخصص",
  Researcher: "پژوهشگر",
  Organization: "سازمان",
  Institution: "مؤسسه",
};

const members = networkMembers;
---

<MainLayout
  lang="fa"
  title="شبکه — KRISM"
  description="شبکه متخصصان، پژوهشگران، مؤسسات و سازمان‌های مرتبط با پزشکی خواب"
>
  <section class="border-b border-krism-border bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8 lg:py-24">

      <p class="text-sm font-semibold text-krism-600">
        شبکه
      </p>

      <h1 class="mt-5 max-w-4xl text-4xl font-semibold tracking-tight text-krism-950 sm:text-5xl lg:text-6xl">
        شبکه پزشکی خواب در خراسان
      </h1>

      <p class="mt-6 max-w-3xl text-lg leading-9 text-krism-muted">
        بستری برای معرفی و ارتباط متخصصان، پژوهشگران، مؤسسات و سازمان‌های
        فعال در حوزه پزشکی خواب.
      </p>

    </div>
  </section>

  <section class="bg-krism-surface">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">

        {members.map((member) => (
          <article class="rounded-2xl border border-krism-border bg-white p-7 transition hover:-translate-y-1 hover:border-krism-500 hover:shadow-lg">

            <div class="flex items-start justify-between gap-4">

              <span class="text-xs font-semibold text-krism-600">
                {typeLabels[member.type] ?? member.type}
              </span>

              {member.city && (
                <span class="text-xs text-krism-muted">
                  {member.city}
                </span>
              )}

            </div>

            <h2 class="mt-7 text-xl font-semibold text-krism-950">
              {member.name}
            </h2>

            {member.specialty && (
              <p class="mt-2 text-sm font-medium text-krism-600">
                {member.specialty}
              </p>
            )}

            {member.affiliation && (
              <p class="mt-2 text-sm text-krism-muted">
                {member.affiliation}
              </p>
            )}

            <p class="mt-5 text-sm leading-8 text-krism-muted">
              {member.description}
            </p>

          </article>
        ))}

      </div>

      <div class="mt-16 rounded-2xl bg-krism-950 p-8 text-white lg:p-12">

        <p class="text-sm font-semibold text-slate-300">
          عضویت در شبکه
        </p>

        <h2 class="mt-4 text-3xl font-semibold">
          علاقه‌مند به همکاری با شبکه KRISM هستید؟
        </h2>

        <p class="mt-5 max-w-2xl text-base leading-8 text-slate-300">
          متخصصان، پژوهشگران، مؤسسات و سازمان‌های مرتبط می‌توانند برای
          همکاری و ارتباط با KRISM تماس بگیرند.
        </p>

        <a
          href="/fa/contact"
          class="mt-8 inline-flex rounded-full bg-white px-6 py-3 text-sm font-semibold text-krism-950"
        >
          تماس با KRISM ←
        </a>

      </div>
    </div>
  </section>
</MainLayout>