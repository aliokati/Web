---
import MainLayout from "../../../layouts/MainLayout.astro";
import LearningResourcePage from "../../../components/LearningResourcePage.astro";
import { resourcesFa as resources } from "../../../data/resources";

const resource = resources.find((item) => item.slug === Astro.params.slug && item.internalPage);
if (!resource) return Astro.rewrite("/404");
const structuredData = { "@context": "https://schema.org", "@type": "Article", headline: resource.title, description: resource.description, inLanguage: "fa", dateModified: resource.reviewedAt, isBasedOn: resource.url, author: { "@type": "Organization", name: "KRISM" }, publisher: { "@type": "Organization", name: "KRISM" } };
---
<MainLayout lang="fa" title={`${resource.title} — KRISM`} description={resource.description} structuredData={structuredData}>
  <LearningResourcePage resource={resource} allResources={resources} lang="fa" />
</MainLayout>
