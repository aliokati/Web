---
import MainLayout from "../../layouts/MainLayout.astro";
import PageHero from "../../components/PageHero.astro";
import ContactExperience from "../../components/ContactExperience.astro";
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL || "";
---

<MainLayout
  lang="fa"
  title="تماس با KRISM"
  description="تماس با نمایندگی خراسان انجمن‌های طب خواب ایران"
>
  <ContactExperience lang="fa" />
  {false && <>
  <PageHero eyebrow="تماس" icon="globe" title="ارتباط با KRISM" description="برای همکاری‌های پژوهشی، آموزشی، حرفه‌ای و سازمانی می‌توانید با تیم KRISM در ارتباط باشید." />

  <section class="surface-mineral">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">

      <div class="grid gap-12 lg:grid-cols-2">

        <div>
          <p class="text-sm font-semibold text-krism-600">
            ارتباط با ما
          </p>

          <h2 class="mt-4 text-3xl font-semibold tracking-tight text-krism-950">
            درخواست‌های حرفه‌ای و سازمانی
          </h2>

          <p class="mt-5 text-base leading-8 text-krism-muted">
            از ارتباط متخصصان، پژوهشگران، مؤسسات پزشکی، انجمن‌ها و سازمان‌های
            علاقه‌مند به حوزه پزشکی خواب استقبال می‌کنیم.
          </p>

          <div class="mt-10 space-y-5">

            <div class="rounded-2xl border border-krism-border bg-white p-6">
              <p class="text-xs font-semibold text-krism-600">
                منطقه
              </p>

              <p class="mt-3 text-base font-medium text-krism-950">
                منطقه خراسان، ایران
              </p>
            </div>

            <div class="rounded-2xl border border-krism-border bg-white p-6">
              <p class="text-xs font-semibold text-krism-600">
                پژوهش
              </p>

              <p class="mt-3 text-sm leading-8 text-krism-muted">
                برای همکاری‌های پژوهشی و فعالیت‌های علمی.
              </p>
            </div>

            <div class="rounded-2xl border border-krism-border bg-white p-6">
              <p class="text-xs font-semibold text-krism-600">
                آموزش و رویدادها
              </p>

              <p class="mt-3 text-sm leading-8 text-krism-muted">
                برای نشست‌های علمی، کارگاه‌ها و همکاری‌های آموزشی.
              </p>
            </div>

          </div>
        </div>

        <div>
          <div class="rounded-2xl border border-krism-border bg-white p-8 lg:p-10">

            <h2 class="text-2xl font-semibold text-krism-950">
              ارسال درخواست
            </h2>

            <p class="mt-3 text-sm leading-8 text-krism-muted">
              این فرم با حفظ حریم خصوصی، برنامه ایمیل شما را باز می‌کند و پیام در وب‌سایت ذخیره نمی‌شود.
            </p>

            <form id="contact-form" class="mt-8 space-y-6" data-recipient={contactEmail}>

              <div>
                <label
                  for="fa-name"
                  class="text-sm font-medium text-krism-950"
                >
                  نام
                </label>

                <input
                  id="fa-name"
                  name="name"
                  type="text"
                  required
                  minlength="2"
                  maxlength="120"
                  autocomplete="name"
                  class="mt-2 w-full rounded-xl border border-krism-border bg-white px-4 py-3 text-sm outline-none transition focus:border-krism-500"
                  placeholder="نام شما"
                />
              </div>

              <div>
                <label
                  for="fa-email"
                  class="text-sm font-medium text-krism-950"
                >
                  ایمیل
                </label>

                <input
                  id="fa-email"
                  name="email"
                  type="email"
                  required
                  maxlength="254"
                  autocomplete="email"
                  dir="ltr"
                  class="mt-2 w-full rounded-xl border border-krism-border bg-white px-4 py-3 text-sm outline-none transition focus:border-krism-500"
                  placeholder="you@example.com"
                />
              </div>

              <div>
                <label
                  for="fa-subject"
                  class="text-sm font-medium text-krism-950"
                >
                  نوع درخواست
                </label>

                <select
                  id="fa-subject"
                  name="subject"
                  class="mt-2 w-full rounded-xl border border-krism-border bg-white px-4 py-3 text-sm outline-none transition focus:border-krism-500"
                >
                  <option value="همکاری پژوهشی">همکاری پژوهشی</option>
                  <option value="برنامه آموزشی">برنامه آموزشی</option>
                  <option value="شبکه حرفه‌ای">شبکه حرفه‌ای</option>
                  <option value="همکاری سازمانی">همکاری سازمانی</option>
                  <option value="درخواست عمومی">درخواست عمومی</option>
                </select>
              </div>

              <div>
                <label
                  for="fa-message"
                  class="text-sm font-medium text-krism-950"
                >
                  پیام
                </label>

                <textarea
                  id="fa-message"
                  name="message"
                  rows="6"
                  required
                  minlength="20"
                  maxlength="5000"
                  class="mt-2 w-full resize-y rounded-xl border border-krism-border bg-white px-4 py-3 text-sm outline-none transition focus:border-krism-500"
                  placeholder="پیام خود را وارد کنید"
                ></textarea>
              </div>

              <button
                type="submit"
                disabled={!contactEmail}
                class="w-full rounded-full bg-krism-950 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-krism-800"
              >
                ارسال درخواست
              </button>

              <p class="text-xs leading-6 text-krism-muted">
                {contactEmail ? "لطفاً اطلاعات پزشکی یا موارد فوری را در پیام وارد نکنید." : "برای فعال شدن فرم، نشانی دریافت‌کننده باید در تنظیمات سایت ثبت شود."}
              </p>
              <p id="contact-status" class="text-sm font-semibold text-krism-700" role="status" aria-live="polite"></p>

            </form>
          </div>
        </div>

      </div>
    </div>
  </section>
  </>}
</MainLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const status = document.querySelector<HTMLElement>("#contact-status");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const recipient = form.dataset.recipient;
    if (!recipient || !status) return;
    const data = new FormData(form);
    const subject = `[KRISM] ${String(data.get("subject") || "درخواست عمومی")}`;
    const body = `نام: ${String(data.get("name") || "")}\nایمیل: ${String(data.get("email") || "")}\n\n${String(data.get("message") || "")}`;
    status.textContent = "برنامه ایمیل شما باز می‌شود؛ لطفاً پیام را پیش از ارسال بازبینی کنید.";
    window.location.href = `mailto:${encodeURIComponent(recipient)}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
