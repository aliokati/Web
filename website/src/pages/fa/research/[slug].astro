---
import MainLayout from "../../../layouts/MainLayout.astro";
import RecordHero from "../../../components/RecordHero.astro";
import { researchProjectsFa as researchProjects } from "../../../data/research";

const project = researchProjects.find(
  (item) => item.slug === Astro.params.slug
);
if (!project) return Astro.rewrite("/404");
const projectMeta = [project.statusLabel && { label: "وضعیت", value: project.statusLabel }, project.date && { label: "آغاز", value: project.date }, project.location && { label: "محل", value: project.location }].filter(Boolean) as Array<{ label: string; value: string }>;
const structuredData = { "@context": "https://schema.org", "@type": "ResearchProject", name: project.title, description: project.description, inLanguage: "fa", url: project.projectUrl || new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href };

---

<MainLayout
  lang="fa"
  title={`${project.title} — KRISM`}
  description={project.description}
  structuredData={structuredData}
>
  {
    project ? (
      <>
        <RecordHero icon="research" eyebrow={project.type} title={project.title} description={project.description} meta={projectMeta} />

        <section class="bg-white">
          <div class="mx-auto max-w-3xl px-6 py-16 lg:px-8 lg:py-20">

            <p class="text-base leading-9 text-krism-text">
              {project.description}
            </p>

            <div class="mt-12 border-t border-krism-border pt-8">
              <p class="text-sm text-krism-muted">
                {project.statusLabel ?? "پروژه جاری"}{project.date ? ` · ${project.date}` : ""}
              </p>

              {project.collaborators && (
                <p class="mt-3 text-sm text-krism-muted">
                  همکاران: {project.collaborators.join("، ")}
                </p>
              )}
            </div>

            <a
              href="/fa/research"
              class="mt-10 inline-block text-sm font-semibold text-krism-600"
            >
              ← بازگشت به پژوهش
            </a>
          </div>
        </section>
      </>
    ) : (
      <section class="bg-white">
        <div class="mx-auto max-w-4xl px-6 py-24 text-center">
          <h1 class="text-3xl font-semibold text-krism-950">
            پروژه پیدا نشد
          </h1>
        </div>
      </section>
    )
  }
</MainLayout>
