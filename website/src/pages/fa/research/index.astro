---
import MainLayout from "../../../layouts/MainLayout.astro";
import ResearchCard from "../../../components/ResearchCard.astro";
import { researchProjects } from "../../../data/research";

const translations: Record<
  string,
  {
    title: string;
    category: string;
    description: string;
    status: string;
  }
> = {
  "sleep-medicine-research-network": {
    title: "شبکه پژوهش پزشکی خواب",
    category: "شبکه پژوهشی",
    description:
      "چارچوبی برای ایجاد ارتباط میان پژوهشگران و متخصصان حوزه پزشکی خواب در منطقه خراسان.",
    status: "در حال انجام",
  },
  "sleep-health-research": {
    title: "پژوهش در سلامت خواب",
    category: "سلامت خواب",
    description:
      "فعالیت‌های پژوهشی با تمرکز بر سلامت خواب، آگاهی‌رسانی و مسائل مرتبط با خواب در سطح جامعه.",
    status: "همکاری",
  },
  "clinical-sleep-medicine": {
    title: "پژوهش در پزشکی بالینی خواب",
    category: "پژوهش بالینی",
    description:
      "حوزه‌ای برای مطالعات بالینی مرتبط با تشخیص، درمان و مدیریت اختلالات خواب.",
    status: "در حال انجام",
  },
};
---

<MainLayout
  lang="fa"
  title="پژوهش — KRISM"
  description="فعالیت‌ها و پروژه‌های پژوهشی KRISM در حوزه پزشکی خواب"
>
  <section class="border-b border-krism-border bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8 lg:py-24">
      <p class="text-sm font-semibold text-krism-600">
        پژوهش
      </p>

      <h1 class="mt-5 max-w-4xl text-4xl font-semibold tracking-tight text-krism-950 sm:text-5xl lg:text-6xl">
        پژوهش و همکاری علمی در پزشکی خواب
      </h1>

      <p class="mt-6 max-w-3xl text-lg leading-9 text-krism-muted">
        KRISM از توسعه پژوهش، ایجاد ارتباط میان پژوهشگران و شکل‌گیری
        همکاری‌های علمی در حوزه پزشکی خواب حمایت می‌کند.
      </p>
    </div>
  </section>

  <section class="bg-krism-surface">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">

      <div class="max-w-2xl">
        <p class="text-sm font-semibold text-krism-600">
          پروژه‌های پژوهشی
        </p>

        <h2 class="mt-4 text-3xl font-semibold tracking-tight text-krism-950">
          فعالیت‌های پژوهشی
        </h2>

        <p class="mt-5 text-base leading-8 text-krism-muted">
          این بخش برای معرفی پروژه‌ها و همکاری‌های پژوهشی KRISM طراحی شده
          است.
        </p>
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        {researchProjects.map((project) => {
          const translation = translations[project.slug];

          return (
            <a
              href={`/fa/research/${project.slug}`}
              class="group block rounded-2xl border border-krism-border bg-white p-7 transition hover:-translate-y-1 hover:border-krism-500 hover:shadow-lg"
            >
              <div class="flex items-start justify-between gap-4">
                <span class="text-xs font-semibold text-krism-600">
                  {translation?.category ?? project.type}
                </span>

                <span class="rounded-full bg-krism-surface px-3 py-1 text-xs text-krism-muted">
                  {translation?.status ?? project.registrationOpen}
                </span>
              </div>

              <h2 class="mt-7 text-xl font-semibold text-krism-950 group-hover:text-krism-600">
                {translation?.title ?? project.title}
              </h2>

              <p class="mt-3 text-sm leading-8 text-krism-muted">
                {translation?.description ?? project.description}
              </p>

              <div class="mt-7 text-sm font-semibold text-krism-600">
                مشاهده پروژه ←
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">

      <div class="rounded-2xl bg-krism-950 p-8 text-white lg:p-12">

        <p class="text-sm font-semibold text-slate-300">
          همکاری پژوهشی
        </p>

        <h2 class="mt-4 text-3xl font-semibold sm:text-4xl">
          پژوهشگر یا مؤسسه فعال در حوزه پزشکی خواب هستید؟
        </h2>

        <p class="mt-5 max-w-2xl text-base leading-8 text-slate-300">
          برای همکاری علمی، شبکه‌سازی پژوهشی یا توسعه پروژه‌های مشترک با
          KRISM در ارتباط باشید.
        </p>

        <a
          href="/fa/contact"
          class="mt-8 inline-flex rounded-full bg-white px-6 py-3 text-sm font-semibold text-krism-950"
        >
          درخواست همکاری ←
        </a>

      </div>
    </div>
  </section>
</MainLayout>