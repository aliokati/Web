---
import MainLayout from "../../../layouts/MainLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import ResearchCard from "../../../components/ResearchCard.astro";
import SectionHeader from "../../../components/SectionHeader.astro";
import { researchProjectsFa as researchProjects } from "../../../data/research";
---

<MainLayout
  lang="fa"
  title="پژوهش — KRISM"
  description="فعالیت‌ها و پروژه‌های پژوهشی KRISM در حوزه پزشکی خواب"
>
  <PageHero eyebrow="پژوهش" icon="research" title="پژوهش و همکاری علمی در پزشکی خواب" description="KRISM از توسعه پژوهش، ارتباط میان پژوهشگران و شکل‌گیری همکاری‌های علمی در حوزه پزشکی خواب حمایت می‌کند." />

  <section class="surface-mineral">
    <div class="page-wrap py-20 lg:py-24">

      <SectionHeader eyebrow="پروژه‌های پژوهشی" title="فعالیت‌های پژوهشی" description="این بخش برای معرفی پروژه‌ها و همکاری‌های پژوهشی KRISM طراحی شده است." />

      <div class="mt-14 grid auto-rows-fr gap-6 lg:grid-cols-2">
        {researchProjects.length ? researchProjects.map((project) => <ResearchCard project={project} lang="fa" />) : <div class="lg:col-span-2 rounded-2xl border border-dashed border-krism-border bg-krism-surface p-10 text-center"><p class="font-semibold text-krism-950">در حال حاضر پروژه تأییدشده‌ای منتشر نشده است.</p><p class="mt-3 text-sm leading-8 text-krism-muted">پروژه‌ها پس از بررسی علمی، محتوایی و ترجمه در این بخش نمایش داده می‌شوند.</p></div>}
      </div>
    </div>
  </section>

  <section class="surface-night">
    <div class="page-wrap py-20 lg:py-24">

      <div class="rounded-[1.75rem] border border-white/12 bg-white/[.045] p-8 text-white shadow-2xl shadow-black/10 lg:p-12">

        <p class="text-sm font-semibold text-slate-300">
          همکاری پژوهشی
        </p>

        <h2 class="mt-4 text-3xl font-semibold sm:text-4xl">
          پژوهشگر یا مؤسسه فعال در حوزه پزشکی خواب هستید؟
        </h2>

        <p class="mt-5 max-w-2xl text-base leading-8 text-slate-300">
          برای همکاری علمی، شبکه‌سازی پژوهشی یا توسعه پروژه‌های مشترک با
          KRISM در ارتباط باشید.
        </p>

        <a
          href="/fa/contact"
          class="mt-8 inline-flex rounded-full bg-white px-6 py-3 text-sm font-semibold text-krism-950"
        >
          درخواست همکاری ←
        </a>

      </div>
    </div>
  </section>
</MainLayout>
