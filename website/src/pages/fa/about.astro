---
import MainLayout from "../../layouts/MainLayout.astro";
import PageHero from "../../components/PageHero.astro";
import AboutExperience from "../../components/AboutExperience.astro";
---

<MainLayout
  lang="fa"
  title="درباره KRISM — پزشکی خواب خراسان"
  description="درباره نمایندگی خراسان انجمن‌های طب خواب ایران"
>
  <AboutExperience lang="fa" />
  {false && <>
  <PageHero eyebrow="درباره KRISM" icon="network" title="توسعه و اتصال جامعه پزشکی خواب در خراسان" description="بستری منطقه‌ای برای پژوهش، آموزش، همکاری حرفه‌ای و ارتقای آگاهی عمومی در حوزه پزشکی خواب." />

  <section class="surface-paper">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">

      <div class="max-w-2xl">
        <p class="text-sm font-semibold text-krism-600">
          حوزه‌های فعالیت
        </p>

        <h2 class="mt-4 text-3xl font-semibold tracking-tight text-krism-950">
          یک بستر منطقه‌ای برای پزشکی خواب
        </h2>

        <p class="mt-5 text-base leading-8 text-krism-muted">
          KRISM تلاش می‌کند میان متخصصان، پژوهشگران، مؤسسات و سازمان‌های
          فعال یا علاقه‌مند به حوزه پزشکی خواب ارتباط و همکاری ایجاد کند.
        </p>
      </div>

      <div class="mt-14 grid gap-6 md:grid-cols-2">

        <div class="rounded-2xl border border-krism-border bg-krism-surface p-8">
          <h2 class="text-xl font-semibold text-krism-950">
            پژوهش
          </h2>

          <p class="mt-4 text-sm leading-8 text-krism-muted">
            حمایت از همکاری‌های علمی، شبکه‌های پژوهشی و توسعه فعالیت‌های
            پژوهشی در زمینه پزشکی خواب.
          </p>
        </div>

        <div class="rounded-2xl border border-krism-border bg-krism-surface p-8">
          <h2 class="text-xl font-semibold text-krism-950">
            آموزش
          </h2>

          <p class="mt-4 text-sm leading-8 text-krism-muted">
            تسهیل برگزاری نشست‌های علمی، کارگاه‌ها و برنامه‌های آموزشی
            حرفه‌ای.
          </p>
        </div>

        <div class="rounded-2xl border border-krism-border bg-krism-surface p-8">
          <h2 class="text-xl font-semibold text-krism-950">
            آگاهی‌رسانی
          </h2>

          <p class="mt-4 text-sm leading-8 text-krism-muted">
            ارتقای آگاهی عمومی درباره اهمیت خواب، سلامت خواب و اختلالات
            مرتبط با خواب.
          </p>
        </div>

        <div class="rounded-2xl border border-krism-border bg-krism-surface p-8">
          <h2 class="text-xl font-semibold text-krism-950">
            همکاری
          </h2>

          <p class="mt-4 text-sm leading-8 text-krism-muted">
            ایجاد ارتباط میان متخصصان، پژوهشگران، مؤسسات و سازمان‌های فعال
            در حوزه پزشکی خواب.
          </p>
        </div>

      </div>
    </div>
  </section>

  <section class="bg-krism-surface">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
      <div class="grid gap-14 lg:grid-cols-2">

        <div>
          <p class="text-sm font-semibold text-krism-600">
            مأموریت
          </p>

          <h2 class="mt-4 text-3xl font-semibold tracking-tight text-krism-950">
            تقویت جامعه پزشکی خواب
          </h2>

          <p class="mt-5 text-base leading-8 text-krism-muted">
            KRISM با هدف تسهیل ارتباط و همکاری میان افراد و سازمان‌های
            فعال در حوزه پزشکی خواب و حمایت از پژوهش، آموزش و آگاهی عمومی
            فعالیت می‌کند.
          </p>
        </div>

        <div>
          <p class="text-sm font-semibold text-krism-600">
            چشم‌انداز
          </p>

          <h2 class="mt-4 text-3xl font-semibold tracking-tight text-krism-950">
            جامعه‌ای متصل و پویا در حوزه پزشکی خواب
          </h2>

          <p class="mt-5 text-base leading-8 text-krism-muted">
            هدف بلندمدت، کمک به شکل‌گیری شبکه‌ای قوی‌تر در منطقه است که
            متخصصان، پژوهشگران و سازمان‌ها بتوانند دانش و تجربه خود را
            به اشتراک گذاشته و همکاری‌های علمی و حرفه‌ای ایجاد کنند.
          </p>
        </div>

      </div>
    </div>
  </section>

  <section class="bg-krism-950 text-white">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">

      <div class="max-w-3xl">
        <p class="text-sm font-semibold text-slate-300">
          همکاری
        </p>

        <h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">
          علاقه‌مند به همکاری هستید؟
        </h2>

        <p class="mt-5 text-base leading-8 text-slate-300">
          از همکاری‌های علمی، آموزشی و سازمانی مرتبط با پزشکی خواب استقبال
          می‌کنیم.
        </p>

        <a
          href="/fa/contact"
          class="mt-8 inline-flex rounded-full bg-white px-6 py-3 text-sm font-semibold text-krism-950 transition hover:bg-slate-100"
        >
          تماس با KRISM ←
        </a>
      </div>

    </div>
  </section>
  </>}
</MainLayout>
