---
import MainLayout from "../../layouts/MainLayout.astro";
import PageHero from "../../components/PageHero.astro";
import ResourceCard from "../../components/ResourceCard.astro";
import PublicationCard from "../../components/PublicationCard.astro";
import { resourcesFa as resources } from "../../data/resources";
import { publicationsFa as publications } from "../../data/publications";

const deprivationSlugs = ["understanding-sleep-deprivation", "what-makes-you-sleep", "how-sleep-affects-health", "how-much-sleep-is-enough"];
const sleepDeprivation = resources.filter((resource) => resource.internalPage && deprivationSlugs.includes(resource.slug));
const sleepHealth = resources.filter((resource) => resource.internalPage && !deprivationSlugs.includes(resource.slug));
const externalResources = resources.filter((resource) => !resource.internalPage);
---

<MainLayout
  lang="fa"
  title="منابع — KRISM"
  description="منابع آموزشی، بالینی، پژوهشی و عمومی مرتبط با پزشکی خواب"
>
  <PageHero eyebrow="منابع" icon="book" title="منابع پزشکی و آموزشی خواب" description="مجموعه‌ای از منابع آموزشی، بالینی، پژوهشی و عمومی برای متخصصان، پژوهشگران و علاقه‌مندان به سلامت خواب." />

  <section class="surface-mineral">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
      <p class="tech-label text-krism-600">کم‌خوابی</p><h2 class="mt-4 text-4xl font-semibold text-krism-950">کمبود خواب را علمی و روشن بشناسید</h2><p class="mt-4 max-w-3xl text-sm leading-8 text-krism-muted">چهار صفحه آموزشی اختصاصی KRISM با بازنویسی فارسی، تصویرسازی مفهومی و ارجاع شفاف به NHLBI.</p>
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">{sleepDeprivation.map((resource) => <ResourceCard resource={resource} lang="fa" />)}</div>
    </div>
  </section>

  <section class="surface-paper"><div class="mx-auto max-w-7xl px-6 py-20 lg:px-8"><p class="tech-label text-krism-600">سلامت خواب</p><h2 class="mt-4 text-4xl font-semibold text-krism-950">الگوی خواب سالم‌تری بسازید</h2><p class="mt-4 max-w-3xl text-sm leading-8 text-krism-muted">راهنماهای عملی برای خواب روزمره، همراه با دفترچه هفت‌روزه اختصاصی که می‌توانید در مرورگر تکمیل و چاپ کنید.</p><div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">{sleepHealth.map((resource) => <ResourceCard resource={resource} lang="fa" />)}</div></div></section>

  <section class="surface-night py-20 text-white"><div class="mx-auto max-w-7xl px-6 lg:px-8"><p class="tech-label text-[#8ee8ef]">درگاه‌های خارجی</p><h2 class="mt-4 text-4xl font-semibold">ادامه یادگیری از سازمان‌های معتبر</h2><p class="mt-4 max-w-2xl text-sm leading-8 text-white/60">این پیوندها در وب‌سایت‌های دیگر باز می‌شوند و معرفی آن‌ها به معنای تأیید رسمی نیست.</p><div class="mt-10 grid gap-6 md:grid-cols-3">{externalResources.map((resource) => <ResourceCard resource={resource} lang="fa" />)}</div></div></section>

  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-20 lg:px-8">

      <p class="text-sm font-semibold text-krism-600">
        انتشارات
      </p>

      <h2 class="mt-4 text-3xl font-semibold text-krism-950">
        پژوهش و مقالات
      </h2>

      <div class="mt-10">{publications.length ? publications.map((publication) => <PublicationCard publication={publication} lang="fa" />) : <div class="rounded-2xl border border-dashed border-krism-border bg-krism-surface p-8 text-sm leading-8 text-krism-muted">انتشارات تأییدشده مرتبط با KRISM پس از بررسی اطلاعات کتاب‌شناختی در این بخش منتشر می‌شوند.</div>}</div>
    </div>
  </section>
</MainLayout>
