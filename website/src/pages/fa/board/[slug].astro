---
import MainLayout from "../../../layouts/MainLayout.astro";
import ScienceIcon from "../../../components/ScienceIcon.astro";
import { boardMembersFa as boardMembers } from "../../../data/board";
const member = boardMembers.find((item) => item.slug === Astro.params.slug);
if (!member) return Astro.rewrite("/fa/404");
const initials = member.name.split(/\s+/).slice(0,2).map((part) => part[0]).join("");
const profiles = [["Google Scholar", member.googleScholar], ["ORCID", member.orcid], ["PubMed", member.pubmed], ["پروفایل دانشگاهی", member.website]].filter((entry) => entry[1]);
const personSchema = { "@context":"https://schema.org", "@type":"Person", name:member.name, jobTitle:member.role, affiliation:{"@type":"Organization",name:member.institution}, url:new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href, image:member.photo ? new URL(member.photo, Astro.site ?? Astro.url.origin).href : undefined, sameAs:profiles.map((entry) => entry[1]) };
---

<MainLayout lang="fa" title={`${member.name} — شورای پژوهشی KRISM`} description={`${member.role}؛ ${member.specialty} در ${member.institution}.`} structuredData={personSchema}>
  <section class="tech-grid-dark relative overflow-hidden bg-krism-950 text-white"><div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#68d7e8]/70 to-transparent"></div><div class="page-wrap relative grid gap-12 py-16 lg:grid-cols-[.72fr_1.28fr] lg:items-center lg:py-24"><div class="board-profile-portrait relative mx-auto aspect-[4/5] w-full max-w-md overflow-hidden rounded-[2rem] border border-white/12">{member.photo ? <img src={member.photo} alt={member.name} class="h-full w-full object-cover" /> : <div class="flex h-full items-center justify-center bg-[#0d3441]"><span class="reference-mark text-3xl">{initials}</span></div>}<div class="absolute inset-0 bg-gradient-to-t from-[#061923]/75 via-transparent to-transparent"></div><span class="absolute bottom-5 right-5 rounded-full border border-white/15 bg-[#061923]/70 px-3 py-1.5 font-mono text-xs font-bold text-[#9de8f2] backdrop-blur">KRISM / BOARD</span></div><div><p class="tech-label text-[#f6d46b]">{member.role}</p><h1 class="mt-6 text-5xl font-medium leading-[1.18] sm:text-6xl lg:text-7xl">{member.name}</h1>{member.credentials && <p class="mt-5 text-lg font-semibold text-[#9de8f2]">{member.credentials}</p>}<p class="mt-7 max-w-2xl text-lg leading-9 text-white/68">{member.specialty}<br />{member.institution}{member.city ? ` · ${member.city}` : ""}</p><div class="mt-9 flex flex-wrap gap-3">{profiles.map(([label,url]) => <a href={url} target="_blank" rel="noreferrer" class="rounded-full border border-white/15 bg-white/5 px-4 py-2.5 text-xs font-bold text-white transition hover:border-[#68d7e8]/45 hover:bg-white/10">{label} ↖</a>)}</div></div></div></section>
  <section class="surface-paper"><div class="page-wrap grid gap-12 py-20 lg:grid-cols-[1.25fr_.75fr] lg:py-28"><article><p class="tech-label text-krism-600">پروفایل / زندگی‌نامه</p><h2 class="mt-5 text-4xl font-medium text-krism-950">زندگی‌نامه حرفه‌ای</h2><p class="mt-7 text-base leading-9 text-krism-muted">{member.biography}</p>{member.researchInterests?.length && <div class="mt-12"><h2 class="text-2xl font-semibold text-krism-950">علایق پژوهشی</h2><div class="mt-5 flex flex-wrap gap-2">{member.researchInterests.map((item) => <span class="rounded-full border border-krism-600/20 bg-white/70 px-4 py-2 text-sm font-semibold text-krism-700">{item}</span>)}</div></div>}{member.selectedPublications?.length && <div class="mt-14"><h2 class="text-2xl font-semibold text-krism-950">انتشارات منتخب</h2><ol class="mt-6 divide-y divide-krism-border rounded-2xl border border-krism-border bg-white/65 px-6">{member.selectedPublications.map((item,index) => <li class="grid gap-4 py-5 sm:grid-cols-[2.5rem_1fr]"><span class="font-mono text-xs font-bold text-krism-600">{String(index+1).padStart(2,"0")}</span><span class="text-sm leading-8 text-krism-muted">{item}</span></li>)}</ol></div>}</article><aside class="space-y-5">{member.education?.length && <div class="rounded-[1.5rem] border border-krism-border bg-white/70 p-6"><ScienceIcon name="book" class="h-7 w-7 text-krism-600" /><h2 class="mt-5 text-xl font-semibold text-krism-950">سوابق دانشگاهی</h2><ul class="mt-5 space-y-3 text-sm leading-8 text-krism-muted">{member.education.map((item) => <li class="border-s-2 border-krism-500/25 ps-4">{item}</li>)}</ul></div>}{member.appointments?.length && <div class="rounded-[1.5rem] border border-krism-border bg-white/70 p-6"><ScienceIcon name="clinical" class="h-7 w-7 text-krism-600" /><h2 class="mt-5 text-xl font-semibold text-krism-950">سمت‌های کنونی</h2><ul class="mt-5 space-y-3 text-sm leading-8 text-krism-muted">{member.appointments.map((item) => <li class="border-s-2 border-krism-500/25 ps-4">{item}</li>)}</ul></div>} {(member.email || member.phone) && <div class="rounded-[1.5rem] bg-krism-950 p-6 text-white"><p class="tech-label text-[#68d7e8]">تماس عمومی</p><div class="mt-5 space-y-3 text-sm">{member.email && <a href={`mailto:${member.email}`} class="block text-white/80 hover:text-white">{member.email}</a>}{member.phone && <a href={`tel:${member.phone}`} class="block text-white/80 hover:text-white">{member.phone}</a>}</div><p class="mt-5 text-xs leading-7 text-white/45">فقط برای مکاتبات حرفه‌ای؛ مدارک پزشکی یا اطلاعات فوری سلامت ارسال نکنید.</p></div>}</aside></div></section>
</MainLayout>
