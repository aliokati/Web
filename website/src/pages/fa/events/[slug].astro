---
import MainLayout from "../../../layouts/MainLayout.astro";
import RecordHero from "../../../components/RecordHero.astro";
import { eventsFa as events } from "../../../data/events";

const event = events.find(
  (item) => item.slug === Astro.params.slug
);
if (!event) return Astro.rewrite("/404");

const date = event ? new Date(event.date) : null;
const structuredData = { "@context": "https://schema.org", "@type": "Event", name: event.title, description: event.description, startDate: event.date, endDate: event.endDate, eventStatus: "https://schema.org/EventScheduled", location: { "@type": "Place", name: event.location }, inLanguage: "fa", url: new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href };
const registrationHref = event.registrationMode === "external" && event.registrationUrl ? event.registrationUrl : `/fa/events/${event.slug}/register`;
---

<MainLayout
  lang="fa"
  title={`${event.title} — KRISM`}
  description={event.description}
  structuredData={structuredData}
>
  {
    event && date ? (
      <>
        <RecordHero icon="calendar" eyebrow={event.type} title={event.title} description={event.description} meta={[{label:"تاریخ",value:date.toLocaleDateString("fa-IR")},{label:"محل",value:event.location},{label:"نوع",value:event.type}]} />

        <section class="bg-white">
          <div class="mx-auto max-w-3xl px-6 py-16 lg:px-8 lg:py-20">

            <p class="text-base leading-9 text-krism-text">
              {event.description}
            </p>

            <div class="content-card mt-12 p-7">

              <h2 class="text-xl font-semibold text-krism-950">
                ثبت‌نام
              </h2>

              <p class="mt-3 text-sm leading-8 text-krism-muted">
                برای ثبت‌نام یا مشاهده اطلاعات تکمیلی از پیوند رسمی زیر استفاده کنید.
              </p>

              {
                event.registrationOpen && (
                  <a
                    href={registrationHref}
                    target={event.registrationMode === "external" ? "_blank" : undefined}
                    rel={event.registrationMode === "external" ? "noreferrer" : undefined}
                    class="mt-6 inline-flex rounded-full bg-krism-950 px-6 py-3 text-sm font-semibold text-white"
                  >
                    {event.registrationMode === "external" ? "ثبت‌نام در وب‌سایت رسمی ↖" : "ثبت‌نام امن ←"}
                  </a>
                )
              }

            </div>

            <a
              href="/fa/events"
              class="mt-10 inline-block text-sm font-semibold text-krism-600"
            >
              ← بازگشت به رویدادها
            </a>
          </div>
        </section>
      </>
    ) : (
      <section class="bg-white">
        <div class="mx-auto max-w-4xl px-6 py-24 text-center">
          <h1 class="text-3xl font-semibold text-krism-950">
            رویداد پیدا نشد
          </h1>
        </div>
      </section>
    )
  }
</MainLayout>
