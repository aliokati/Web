---
import MainLayout from "../../../layouts/MainLayout.astro";
import { events } from "../../../data/events";

const now = new Date();

const upcomingEvents = events
  .filter((event) => new Date(event.date) >= now)
  .sort(
    (a, b) =>
      new Date(a.date).getTime() -
      new Date(b.date).getTime()
  );

const pastEvents = events
  .filter((event) => new Date(event.date) < now)
  .sort(
    (a, b) =>
      new Date(b.date).getTime() -
      new Date(a.date).getTime()
  );
---

<MainLayout
  lang="fa"
  title="رویدادها — KRISM"
  description="نشست‌ها، کارگاه‌ها و برنامه‌های علمی KRISM"
>
  <section class="border-b border-krism-border bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8 lg:py-24">
      <p class="text-sm font-semibold text-krism-600">
        رویدادها
      </p>

      <h1 class="mt-5 max-w-4xl text-4xl font-semibold tracking-tight text-krism-950 sm:text-5xl lg:text-6xl">
        آموزش و رویدادهای علمی
      </h1>

      <p class="mt-6 max-w-3xl text-lg leading-9 text-krism-muted">
        نشست‌ها، کارگاه‌ها و برنامه‌های آموزشی و علمی مرتبط با پزشکی خواب.
      </p>
    </div>
  </section>

  <section class="bg-krism-surface">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">

      <h2 class="text-3xl font-semibold text-krism-950">
        رویدادهای پیش‌رو
      </h2>

      {
        upcomingEvents.length > 0 ? (
          <div class="mt-10 grid gap-6 lg:grid-cols-2">
            {upcomingEvents.map((event) => {
              const date = new Date(event.date);

              return (
                <a
                  href={`/fa/events/${event.slug}`}
                  class="group block rounded-2xl border border-krism-border bg-white p-7 transition hover:-translate-y-1 hover:border-krism-500 hover:shadow-lg"
                >
                  <div class="flex gap-6">

                    <div class="flex h-20 w-20 shrink-0 flex-col items-center justify-center rounded-xl bg-krism-950 text-white">
                      <span class="text-2xl font-semibold">
                        {date.getDate()}
                      </span>

                      <span class="text-xs text-slate-300">
                        {date.toLocaleDateString("fa-IR", {
                          month: "short",
                        })}
                      </span>
                    </div>

                    <div>
                      <p class="text-xs font-semibold text-krism-600">
                        {event.type}
                      </p>

                      <h3 class="mt-2 text-xl font-semibold text-krism-950 group-hover:text-krism-600">
                        {event.title}
                      </h3>

                      <p class="mt-2 text-sm text-krism-muted">
                        {event.location}
                      </p>
                    </div>

                  </div>

                  <p class="mt-6 text-sm leading-8 text-krism-muted">
                    {event.description}
                  </p>

                  <div class="mt-6 text-sm font-semibold text-krism-600">
                    مشاهده رویداد ←
                  </div>
                </a>
              );
            })}
          </div>
        ) : (
          <div class="mt-10 rounded-2xl border border-krism-border bg-white p-10 text-center">
            <p class="text-sm text-krism-muted">
              در حال حاضر رویداد پیش‌رو ثبت نشده است.
            </p>
          </div>
        )
      }

      {
        pastEvents.length > 0 && (
          <div class="mt-20">
            <h2 class="text-3xl font-semibold text-krism-950">
              رویدادهای گذشته
            </h2>

            <div class="mt-10 grid gap-6 lg:grid-cols-2">
              {pastEvents.map((event) => (
                <a
                  href={`/fa/events/${event.slug}`}
                  class="block rounded-2xl border border-krism-border bg-white p-7"
                >
                  <p class="text-xs font-semibold text-krism-600">
                    {event.type}
                  </p>

                  <h3 class="mt-3 text-xl font-semibold text-krism-950">
                    {event.title}
                  </h3>

                  <p class="mt-3 text-sm text-krism-muted">
                    {event.location}
                  </p>
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>
</MainLayout>