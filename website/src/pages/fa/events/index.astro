---
import MainLayout from "../../../layouts/MainLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import { eventsFa as events } from "../../../data/events";

const now = new Date();

const upcomingEvents = events
  .filter((event) => new Date(event.date) >= now)
  .sort(
    (a, b) =>
      new Date(a.date).getTime() -
      new Date(b.date).getTime()
  );

const pastEvents = events
  .filter((event) => new Date(event.date) < now)
  .sort(
    (a, b) =>
      new Date(b.date).getTime() -
      new Date(a.date).getTime()
  );
---

<MainLayout
  lang="fa"
  title="رویدادها — KRISM"
  description="نشست‌ها، کارگاه‌ها و برنامه‌های علمی KRISM"
>
  <PageHero eyebrow="رویدادها" icon="calendar" title="آموزش و رویدادهای علمی" description="نشست‌ها، کارگاه‌ها و برنامه‌های آموزشی و علمی مرتبط با پزشکی خواب." />

  <section class="surface-mineral">
    <div class="page-wrap py-20 lg:py-24">

      <h2 class="text-3xl font-semibold text-krism-950">
        رویدادهای پیش‌رو
      </h2>

      {
        upcomingEvents.length > 0 ? (
          <div class="mt-12 grid auto-rows-fr gap-6 lg:grid-cols-2">
            {upcomingEvents.map((event) => {
              const date = new Date(event.date);

              return (
                <a
                  href={`/fa/events/${event.slug}`}
                  class="content-card group flex min-h-full flex-col p-7"
                >
                  <div class="flex gap-6">

                    <div class="card-date-panel flex h-20 w-20 shrink-0 flex-col items-center justify-center rounded-xl text-white">
                      <span class="text-2xl font-semibold">
                        {date.getDate()}
                      </span>

                      <span class="text-xs text-slate-300">
                        {date.toLocaleDateString("fa-IR", {
                          month: "short",
                        })}
                      </span>
                    </div>

                    <div>
                      <p class="text-xs font-semibold text-krism-600">
                        {event.type}
                      </p>

                      <h3 class="mt-2 text-xl font-semibold text-krism-950 group-hover:text-krism-600">
                        {event.title}
                      </h3>

                      <p class="mt-2 text-sm text-krism-muted">
                        {event.location}
                      </p>
                    </div>

                  </div>

                  <p class="mt-6 flex-1 text-sm leading-8 text-krism-muted">
                    {event.description}
                  </p>

                  <div class="card-action mt-6 border-t border-white/10 pt-5">
                    مشاهده رویداد ←
                  </div>
                </a>
              );
            })}
          </div>
        ) : (
          <div class="content-card mt-10 p-10 text-center">
            <p class="text-sm text-krism-muted">
              در حال حاضر رویداد پیش‌رو ثبت نشده است.
            </p>
          </div>
        )
      }

      {
        pastEvents.length > 0 && (
          <div class="mt-20">
            <h2 class="text-3xl font-semibold text-krism-950">
              رویدادهای گذشته
            </h2>

            <div class="mt-10 grid auto-rows-fr gap-6 lg:grid-cols-2">
              {pastEvents.map((event) => (
                <a
                  href={`/fa/events/${event.slug}`}
                  class="content-card block min-h-full p-7"
                >
                  <p class="text-xs font-semibold text-krism-600">
                    {event.type}
                  </p>

                  <h3 class="mt-3 text-xl font-semibold text-krism-950">
                    {event.title}
                  </h3>

                  <p class="mt-3 text-sm text-krism-muted">
                    {event.location}
                  </p>
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>
</MainLayout>
