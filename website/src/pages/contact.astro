---
import MainLayout from "../layouts/MainLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
---

<MainLayout
  title="Contact KRISM"
  description="Contact the Khorasan Representative of Iranian Sleep Medicine Societies."
>
  <section class="border-b border-krism-border bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8 lg:py-24">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-krism-600">
        Contact
      </p>

      <h1 class="mt-5 max-w-4xl text-4xl font-semibold tracking-tight text-krism-950 sm:text-5xl lg:text-6xl">
        Connect with KRISM
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-8 text-krism-muted">
        For research, educational, professional or organizational
        collaboration, please contact the KRISM team.
      </p>
    </div>
  </section>

  <section class="bg-krism-surface">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2">

        <div>
          <SectionHeader
            eyebrow="Get in touch"
            title="Professional and organizational inquiries"
            description="We welcome communication from healthcare professionals, researchers, institutions, medical societies and organizations interested in sleep medicine."
          />

          <div class="mt-10 space-y-5">

            <div class="rounded-2xl border border-krism-border bg-white p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.15em] text-krism-600">
                Region
              </p>

              <p class="mt-3 text-base font-medium text-krism-950">
                Khorasan Region, Iran
              </p>
            </div>

            <div class="rounded-2xl border border-krism-border bg-white p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.15em] text-krism-600">
                Research
              </p>

              <p class="mt-3 text-sm leading-7 text-krism-muted">
                For research collaboration, scientific initiatives and
                investigator-related inquiries.
              </p>
            </div>

            <div class="rounded-2xl border border-krism-border bg-white p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.15em] text-krism-600">
                Education & Events
              </p>

              <p class="mt-3 text-sm leading-7 text-krism-muted">
                For scientific meetings, workshops and educational
                collaboration.
              </p>
            </div>

          </div>
        </div>

        <div>
          <div class="rounded-2xl border border-krism-border bg-white p-8 lg:p-10">
            <h2 class="text-2xl font-semibold text-krism-950">
              Send an inquiry
            </h2>

            <p class="mt-3 text-sm leading-7 text-krism-muted">
              The form interface is prepared for future connection to a
              secure form-processing service.
            </p>

            <form class="mt-8 space-y-6">

              <div>
                <label
                  for="name"
                  class="text-sm font-medium text-krism-950"
                >
                  Name
                </label>

                <input
                  id="name"
                  name="name"
                  type="text"
                  class="mt-2 w-full rounded-xl border border-krism-border bg-white px-4 py-3 text-sm outline-none transition focus:border-krism-500"
                  placeholder="Your name"
                />
              </div>

              <div>
                <label
                  for="email"
                  class="text-sm font-medium text-krism-950"
                >
                  Email
                </label>

                <input
                  id="email"
                  name="email"
                  type="email"
                  class="mt-2 w-full rounded-xl border border-krism-border bg-white px-4 py-3 text-sm outline-none transition focus:border-krism-500"
                  placeholder="you@example.com"
                />
              </div>

              <div>
                <label
                  for="subject"
                  class="text-sm font-medium text-krism-950"
                >
                  Inquiry type
                </label>

                <select
                  id="subject"
                  name="subject"
                  class="mt-2 w-full rounded-xl border border-krism-border bg-white px-4 py-3 text-sm outline-none transition focus:border-krism-500"
                >
                  <option>Research collaboration</option>
                  <option>Educational event</option>
                  <option>Professional network</option>
                  <option>Organizational collaboration</option>
                  <option>General inquiry</option>
                </select>
              </div>

              <div>
                <label
                  for="message"
                  class="text-sm font-medium text-krism-950"
                >
                  Message
                </label>

                <textarea
                  id="message"
                  name="message"
                  rows="6"
                  class="mt-2 w-full resize-y rounded-xl border border-krism-border bg-white px-4 py-3 text-sm outline-none transition focus:border-krism-500"
                  placeholder="How can we help?"
                ></textarea>
              </div>

              <button
                type="button"
                class="w-full rounded-full bg-krism-950 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-krism-800"
              >
                Send inquiry
              </button>

              <p class="text-xs leading-6 text-krism-muted">
                This form is currently a presentation interface. It will be
                connected to the KRISM backend in a later phase.
              </p>

            </form>
          </div>
        </div>

      </div>
    </div>
  </section>
</MainLayout>