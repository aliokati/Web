---
import MainLayout from "../layouts/MainLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import PageHero from "../components/PageHero.astro";
import ContactExperience from "../components/ContactExperience.astro";
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL || "";
---

<MainLayout
  title="Contact KRISM"
  description="Contact the Khorasan Representative of Iranian Sleep Medicine Societies."
>
  <ContactExperience />
  {false && <>
  <PageHero eyebrow="Contact" icon="globe" title="Connect with KRISM" description="For research, educational, professional or organizational collaboration, contact the KRISM team." />

  <section class="surface-mineral">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2">

        <div>
          <SectionHeader
            eyebrow="Get in touch"
            title="Professional and organizational inquiries"
            description="We welcome communication from healthcare professionals, researchers, institutions, medical societies and organizations interested in sleep medicine."
          />

          <div class="mt-10 space-y-5">

            <div class="rounded-2xl border border-krism-border bg-white p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.15em] text-krism-600">
                Region
              </p>

              <p class="mt-3 text-base font-medium text-krism-950">
                Khorasan Region, Iran
              </p>
            </div>

            <div class="rounded-2xl border border-krism-border bg-white p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.15em] text-krism-600">
                Research
              </p>

              <p class="mt-3 text-sm leading-7 text-krism-muted">
                For research collaboration, scientific initiatives and
                investigator-related inquiries.
              </p>
            </div>

            <div class="rounded-2xl border border-krism-border bg-white p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.15em] text-krism-600">
                Education & Events
              </p>

              <p class="mt-3 text-sm leading-7 text-krism-muted">
                For scientific meetings, workshops and educational
                collaboration.
              </p>
            </div>

          </div>
        </div>

        <div>
          <div class="rounded-2xl border border-krism-border bg-white p-8 lg:p-10">
            <h2 class="text-2xl font-semibold text-krism-950">
              Send an inquiry
            </h2>

            <p class="mt-3 text-sm leading-7 text-krism-muted">
              This privacy-preserving form opens your email application. The website does not store your message.
            </p>

            <form id="contact-form" class="mt-8 space-y-6" data-recipient={contactEmail}>

              <div>
                <label
                  for="name"
                  class="text-sm font-medium text-krism-950"
                >
                  Name
                </label>

                <input
                  id="name"
                  name="name"
                  type="text"
                  required
                  minlength="2"
                  maxlength="120"
                  autocomplete="name"
                  class="mt-2 w-full rounded-xl border border-krism-border bg-white px-4 py-3 text-sm outline-none transition focus:border-krism-500"
                  placeholder="Your name"
                />
              </div>

              <div>
                <label
                  for="email"
                  class="text-sm font-medium text-krism-950"
                >
                  Email
                </label>

                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  maxlength="254"
                  autocomplete="email"
                  class="mt-2 w-full rounded-xl border border-krism-border bg-white px-4 py-3 text-sm outline-none transition focus:border-krism-500"
                  placeholder="you@example.com"
                />
              </div>

              <div>
                <label
                  for="subject"
                  class="text-sm font-medium text-krism-950"
                >
                  Inquiry type
                </label>

                <select
                  id="subject"
                  name="subject"
                  class="mt-2 w-full rounded-xl border border-krism-border bg-white px-4 py-3 text-sm outline-none transition focus:border-krism-500"
                >
                  <option value="Research collaboration">Research collaboration</option>
                  <option value="Educational event">Educational event</option>
                  <option value="Professional network">Professional network</option>
                  <option value="Organizational collaboration">Organizational collaboration</option>
                  <option value="General inquiry">General inquiry</option>
                </select>
              </div>

              <div>
                <label
                  for="message"
                  class="text-sm font-medium text-krism-950"
                >
                  Message
                </label>

                <textarea
                  id="message"
                  name="message"
                  rows="6"
                  required
                  minlength="20"
                  maxlength="5000"
                  class="mt-2 w-full resize-y rounded-xl border border-krism-border bg-white px-4 py-3 text-sm outline-none transition focus:border-krism-500"
                  placeholder="How can we help?"
                ></textarea>
              </div>

              <button
                type="submit"
                disabled={!contactEmail}
                class="w-full rounded-full bg-krism-950 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-krism-800"
              >
                Send inquiry
              </button>

              <p class="text-xs leading-6 text-krism-muted">
                {contactEmail ? "Please do not include medical records or urgent health information." : "The contact recipient must be configured before this form can be used."}
              </p>
              <p id="contact-status" class="text-sm font-semibold text-krism-700" role="status" aria-live="polite"></p>

            </form>
          </div>
        </div>

      </div>
    </div>
  </section>
  </>}
</MainLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const status = document.querySelector<HTMLElement>("#contact-status");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const recipient = form.dataset.recipient;
    if (!recipient || !status) return;
    const data = new FormData(form);
    const subject = `[KRISM] ${String(data.get("subject") || "General inquiry")}`;
    const body = `Name: ${String(data.get("name") || "")}\nEmail: ${String(data.get("email") || "")}\n\n${String(data.get("message") || "")}`;
    status.textContent = "Your email application is opening. Review the message there before sending.";
    window.location.href = `mailto:${encodeURIComponent(recipient)}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
