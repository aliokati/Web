---
import MainLayout from "../layouts/MainLayout.astro";
import SleepSystemGraphic from "./SleepSystemGraphic.astro";
import ScienceIcon from "./ScienceIcon.astro";
interface Props { lang?: "en" | "fa" }
const { lang = "en" } = Astro.props;
const fa = lang === "fa";
const t = (en: string, persian: string) => fa ? persian : en;
---

<MainLayout lang={lang} title={t("Should I see a sleep professional? — KRISM", "آیا باید به متخصص خواب مراجعه کنم؟ — KRISM")} description={t("A private educational sleep check that helps organize common complaints and suggests a responsible next step.", "ارزیابی آموزشی و خصوصی خواب برای دسته‌بندی مشکلات شایع و پیشنهاد گام بعدی مسئولانه.")}>
  <section class="science-hero tech-grid-dark relative overflow-hidden bg-krism-950 text-white">
    <div class="absolute -start-32 -top-48 h-[34rem] w-[34rem] rounded-full bg-[#287789]/35 blur-3xl"></div>
    <div class="science-nodes pointer-events-none absolute inset-0 opacity-30"></div>
    <div class="page-wrap relative grid gap-12 py-20 lg:grid-cols-[1.05fr_.95fr] lg:items-center lg:py-24">
      <div class="max-w-4xl">
        <div class="flex items-center gap-4"><p class="tech-label text-[#68d7e8]">KRISM / SLEEP_GUIDE_01</p><span class="h-px w-12 bg-white/20"></span><p class="text-xs font-bold uppercase tracking-[.12em] text-[#f6d46b]">{t("Private · educational", "خصوصی · آموزشی")}</p></div>
        <h1 class="mt-7 text-5xl font-medium leading-[.97] tracking-[-.045em] sm:text-6xl lg:text-7xl">{t("Should I visit a", "آیا باید به")} <em class="font-normal text-[#cbe8ee]">{t("sleep professional?", "متخصص خواب مراجعه کنم؟")}</em></h1>
        <p class="mt-7 max-w-3xl text-lg leading-9 text-white/70">{t("A short guided conversation can organize your symptoms into the six major areas of sleep disorders and help you choose a sensible next step.", "یک گفت‌وگوی هدایت‌شده کوتاه می‌تواند علائم شما را در شش حوزه اصلی اختلالات خواب دسته‌بندی کند و به انتخاب گام بعدی مناسب کمک کند.")}</p>
        <div class="mt-9 flex flex-wrap gap-2 text-xs font-bold uppercase tracking-[.08em] text-white/70"><span class="flex items-center gap-2 rounded-full border border-white/12 px-3 py-2"><ScienceIcon name="shield" class="h-4 w-4 text-[#68d7e8]" />{t("Private", "خصوصی")}</span><span class="flex items-center gap-2 rounded-full border border-white/12 px-3 py-2"><ScienceIcon name="clock" class="h-4 w-4 text-[#68d7e8]" />{t("5–8 minutes", "۵ تا ۸ دقیقه")}</span><span class="flex items-center gap-2 rounded-full border border-white/12 px-3 py-2"><ScienceIcon name="clinical" class="h-4 w-4 text-[#68d7e8]" />{t("Non-diagnostic", "غیرتشخیصی")}</span></div>
      </div>
      <SleepSystemGraphic lang={lang} />
    </div>
  </section>

  <section class="bg-[#f6f1e9] py-12 lg:py-20">
    <div class="page-wrap grid gap-6 lg:grid-cols-[.72fr_1.28fr] lg:items-start">
      <aside class="space-y-4 lg:sticky lg:top-5">
        <div class="rounded-[1.5rem] bg-white p-6 shadow-sm">
          <p class="text-xs font-bold uppercase tracking-[.14em] text-krism-600">{t("Before you begin", "پیش از شروع")}</p>
          <ul class="mt-5 space-y-4 text-sm leading-7 text-krism-muted">
            <li class="flex gap-3"><ScienceIcon name="person" class="mt-1 h-5 w-5 shrink-0 text-krism-600" /><span>{t("For adults aged 18 and over", "برای بزرگسالان ۱۸ سال و بیشتر")}</span></li>
            <li class="flex gap-3"><ScienceIcon name="clock" class="mt-1 h-5 w-5 shrink-0 text-krism-600" /><span>{t("Takes about 5–8 minutes", "حدود ۵ تا ۸ دقیقه زمان می‌برد")}</span></li>
            <li class="flex gap-3"><ScienceIcon name="shield" class="mt-1 h-5 w-5 shrink-0 text-krism-600" /><span>{t("Your answers stay in this browser and are not saved", "پاسخ‌ها در همین مرورگر می‌مانند و ذخیره نمی‌شوند")}</span></li>
            <li class="flex gap-3"><ScienceIcon name="clinical" class="mt-1 h-5 w-5 shrink-0 text-krism-600" /><span>{t("Educational guidance—not a diagnosis", "راهنمای آموزشی است، نه تشخیص پزشکی")}</span></li>
          </ul>
        </div>
        <div class="rounded-[1.5rem] border border-[#e67b67]/25 bg-[#fff4ef] p-6">
          <p class="font-bold text-krism-950">{t("Need urgent help?", "به کمک فوری نیاز دارید؟")}</p>
          <p class="mt-3 text-sm leading-7 text-krism-muted">{t("If you are struggling to breathe, have chest pain, severe confusion or another medical emergency, stop and contact local emergency services now.", "اگر دچار تنگی نفس، درد قفسه سینه، گیجی شدید یا وضعیت اورژانسی دیگری هستید، اکنون ارزیابی را متوقف کرده و با خدمات اورژانس محلی تماس بگیرید.")}</p>
        </div>
        <p class="px-2 text-xs leading-6 text-krism-muted">{t("KRISM educational routing checklist v1.0 (updated October 2026). This is not a validated medical screening instrument. It does not diagnose, exclude disease or replace professional assessment.", "چک‌لیست هدایت آموزشی KRISM نسخه ۱٫۰ (به‌روزرسانی مهر ۱۴۰۵). این ابزار غربالگری پزشکی اعتبارسنجی‌شده نیست، بیماری را تشخیص یا رد نمی‌کند و جایگزین ارزیابی حرفه‌ای نیست.")}</p>
      </aside>

      <div id="sleep-check" data-lang={lang} class="overflow-hidden rounded-[2rem] border border-krism-600/20 bg-white shadow-[0_32px_90px_rgba(10,35,51,.12)]">
        <div class="border-b border-krism-border bg-[#f9fbfa] px-6 py-5 sm:px-9">
          <div class="flex items-center justify-between gap-4"><p id="check-stage" class="tech-label text-krism-600">{t("Welcome", "خوش آمدید")}</p><p id="check-count" class="font-mono text-[10px] text-krism-muted"></p></div>
          <div class="screening-progress mt-4"><span id="check-progress" style="width: 0%"></span></div>
        </div>
        <div class="min-h-[34rem] p-6 sm:p-9">
          <div id="check-live" aria-live="polite">
            <div id="check-intro">
              <div class="orbital-mark flex h-20 w-20 items-center justify-center rounded-full bg-[#cbe8ee] text-4xl text-krism-950">☾</div>
              <h2 class="mt-8 max-w-2xl text-4xl font-medium leading-tight text-krism-950">{t("Let’s make sense of what you are experiencing.", "بیایید وضعیت خواب شما را بهتر درک کنیم.")}</h2>
              <p class="mt-5 max-w-2xl text-base leading-8 text-krism-muted">{t("We will begin with safety questions, review common symptoms, then explore the area most relevant to your answers. You can stop at any time.", "ابتدا چند پرسش ایمنی مطرح می‌شود، سپس علائم شایع مرور شده و مرتبط‌ترین حوزه با پاسخ‌های شما بررسی می‌شود. هر زمان بخواهید می‌توانید متوقف شوید.")}</p>
              <button id="check-start" type="button" class="mt-9 rounded-full bg-krism-950 px-7 py-4 text-sm font-bold text-white transition hover:bg-krism-700">{t("Begin the sleep check", "شروع ارزیابی خواب")}</button>
            </div>
            <div id="check-question" class="hidden">
              <div id="question-icon" class="flex h-14 w-14 items-center justify-center rounded-full bg-[#dcece5] text-2xl text-krism-950">?</div>
              <h2 id="question-text" class="mt-7 max-w-2xl text-3xl font-medium leading-tight text-krism-950"></h2>
              <p id="question-help" class="mt-4 max-w-2xl text-sm leading-7 text-krism-muted"></p>
              <div id="question-options" class="mt-8 grid gap-3 sm:grid-cols-2"></div>
              <button id="check-back" type="button" class="mt-7 text-sm font-bold text-krism-muted underline decoration-krism-border underline-offset-4">{t("Start over", "شروع دوباره")}</button>
            </div>
            <div id="check-result" class="hidden"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="surface-paper"><div class="page-wrap py-20 lg:py-24"><div class="grid gap-10 lg:grid-cols-[.75fr_1.25fr]"><div><p class="tech-label text-krism-600">{t("How it works", "نحوه کار")}</p><h2 class="mt-6 text-4xl font-medium text-krism-950">{t("Transparent by design.", "شفاف، از پایه.")}</h2></div><div class="grid gap-4 sm:grid-cols-3">{[["01",t("Organize", "دسته‌بندی"),t("Answers are mapped to six recognized sleep-disorder areas.", "پاسخ‌ها در شش حوزه شناخته‌شده اختلالات خواب دسته‌بندی می‌شوند.")],["02",t("Explore", "بررسی"),t("A short follow-up explores the strongest concern area.", "یک پیگیری کوتاه مهم‌ترین حوزه نگرانی را بررسی می‌کند.")],["03",t("Act", "اقدام"),t("You receive a plain-language next step and trusted resources.", "یک گام بعدی روشن و منابع معتبر دریافت می‌کنید.")]].map(([n,title,text]) => (<div class="lift-link rounded-2xl border border-krism-border bg-white/75 p-6 backdrop-blur-sm"><p class="font-mono text-xs font-bold text-krism-600">STEP / {n}</p><h3 class="mt-8 text-2xl font-medium text-krism-950">{title}</h3><p class="mt-3 text-sm leading-7 text-krism-muted">{text}</p></div>))}</div></div></div></section>

  <script>
    type Locale = "en" | "fa";
    type Category = "insomnia" | "breathing" | "sleepiness" | "circadian" | "parasomnia" | "movement";
    type Copy = { en: string; fa: string };
    type Question = { text: Copy; help?: Copy; category?: Category; weights?: Partial<Record<Category, number>>; danger?: string };
    const root = document.querySelector<HTMLElement>("#sleep-check");
    if (root) {
      const lang = (root.dataset.lang || "en") as Locale;
      const c = (copy: Copy) => copy[lang];
      const el = <T extends HTMLElement>(id: string) => document.querySelector<T>(id)!;
      const intro = el<HTMLElement>("#check-intro"), questionPanel = el<HTMLElement>("#check-question"), resultPanel = el<HTMLElement>("#check-result");
      const stage = el<HTMLElement>("#check-stage"), count = el<HTMLElement>("#check-count"), progress = el<HTMLElement>("#check-progress"), questionText = el<HTMLElement>("#question-text"), questionHelp = el<HTMLElement>("#question-help"), options = el<HTMLElement>("#question-options");

      const labels: Record<Category, Copy> = {
        insomnia: { en: "Insomnia concerns", fa: "نگرانی‌های بی‌خوابی" }, breathing: { en: "Sleep-related breathing concerns", fa: "نگرانی‌های تنفسی مرتبط با خواب" }, sleepiness: { en: "Excessive sleepiness concerns", fa: "نگرانی‌های خواب‌آلودگی بیش از حد" }, circadian: { en: "Body-clock and sleep-timing concerns", fa: "نگرانی‌های ساعت زیستی و زمان‌بندی خواب" }, parasomnia: { en: "Unusual sleep behaviors", fa: "رفتارهای غیرمعمول در خواب" }, movement: { en: "Sleep-related movement concerns", fa: "نگرانی‌های حرکتی مرتبط با خواب" },
      };
      const details: Record<Category, { assessment: Copy; resource: string; resourceLabel: Copy; questions: Question[] }> = {
        insomnia: { assessment: { en: "A clinician can assess duration, frequency, daytime effects and possible causes of insomnia symptoms.", fa: "متخصص می‌تواند مدت، تکرار، اثرات روزانه و علل احتمالی علائم بی‌خوابی را بررسی کند." }, resource: "understanding-insomnia", resourceLabel: { en: "Understanding insomnia", fa: "آشنایی با بی‌خوابی" }, questions: [
          { text:{en:"Does it usually take you more than about 30 minutes to fall asleep?",fa:"آیا معمولاً به خواب رفتن شما بیش از حدود ۳۰ دقیقه طول می‌کشد؟"} }, { text:{en:"Do you wake repeatedly or earlier than intended and struggle to return to sleep?",fa:"آیا بارها بیدار می‌شوید یا زودتر از زمان مورد نظر بیدار شده و برای خواب مجدد مشکل دارید؟"} }, { text:{en:"Does this happen at least three nights in a typical week?",fa:"آیا این وضعیت در یک هفته معمول دست‌کم سه شب رخ می‌دهد؟"} }, { text:{en:"Does it affect mood, concentration, work or daytime functioning?",fa:"آیا بر خلق، تمرکز، کار یا عملکرد روزانه شما اثر می‌گذارد؟"} },
        ]},
        breathing: { assessment: { en: "A clinician can review breathing symptoms, medical risk factors and whether a sleep study is appropriate.", fa: "متخصص می‌تواند علائم تنفسی، عوامل خطر پزشکی و نیاز احتمالی به مطالعه خواب را بررسی کند." }, resource: "snoring-and-sleep-apnea", resourceLabel:{en:"Snoring and sleep apnea warning signs",fa:"علائم هشدار خرخر و آپنه خواب"}, questions:[
          {text:{en:"Has someone witnessed pauses in your breathing during sleep?",fa:"آیا کسی توقف تنفس شما را هنگام خواب مشاهده کرده است؟"}}, {text:{en:"Do you wake choking, gasping or with a racing heartbeat?",fa:"آیا با احساس خفگی، نفس‌نفس زدن یا تپش قلب بیدار می‌شوید؟"}}, {text:{en:"Is your snoring loud, frequent or disruptive to others?",fa:"آیا خرخر شما بلند، مکرر یا برای دیگران آزاردهنده است؟"}}, {text:{en:"Do you have morning headaches, dry mouth or marked daytime sleepiness?",fa:"آیا سردرد صبحگاهی، خشکی دهان یا خواب‌آلودگی قابل توجه روزانه دارید؟"}},
        ]},
        sleepiness: { assessment:{en:"A clinician can distinguish sleepiness from fatigue and review sleep duration, medications and central sleep disorders.",fa:"متخصص می‌تواند خواب‌آلودگی را از خستگی تفکیک کرده و مدت خواب، داروها و اختلالات مرکزی خواب را بررسی کند."}, resource:"excessive-daytime-sleepiness", resourceLabel:{en:"Excessive daytime sleepiness",fa:"خواب‌آلودگی بیش از حد روزانه"}, questions:[
          {text:{en:"Do you unintentionally fall asleep during quiet daytime activities?",fa:"آیا هنگام فعالیت‌های آرام روزانه ناخواسته به خواب می‌روید؟"}}, {text:{en:"Do you experience irresistible sleep episodes despite allowing enough time for sleep?",fa:"آیا با وجود اختصاص زمان کافی برای خواب، حملات مقاومت‌ناپذیر خواب را تجربه می‌کنید؟"}}, {text:{en:"Have strong emotions ever been followed by sudden muscle weakness?",fa:"آیا پس از هیجان شدید دچار ضعف ناگهانی عضلات شده‌اید؟"}}, {text:{en:"Does sleepiness interfere with study, work, conversation or safety?",fa:"آیا خواب‌آلودگی در تحصیل، کار، گفت‌وگو یا ایمنی شما اختلال ایجاد می‌کند؟"}},
        ]},
        circadian: { assessment:{en:"A two-week sleep diary can help a clinician review timing across workdays and free days.",fa:"دفترچه دو هفته‌ای خواب می‌تواند به متخصص برای بررسی زمان‌بندی در روزهای کاری و آزاد کمک کند."}, resource:"body-clock-and-circadian-rhythm", resourceLabel:{en:"Your body clock and sleep timing",fa:"ساعت زیستی و زمان‌بندی خواب"}, questions:[
          {text:{en:"Can you sleep normally when allowed to follow your preferred schedule?",fa:"آیا وقتی برنامه زمانی دلخواهتان را دنبال می‌کنید، خواب طبیعی دارید؟"}}, {text:{en:"Is your preferred sleep time more than two hours earlier or later than required?",fa:"آیا زمان خواب دلخواه شما بیش از دو ساعت زودتر یا دیرتر از زمان مورد نیاز است؟"}}, {text:{en:"Do shift work or changing schedules repeatedly disrupt your sleep?",fa:"آیا شیفت کاری یا تغییر برنامه‌ها مرتباً خواب شما را مختل می‌کند؟"}}, {text:{en:"Has this timing problem affected attendance, work, study or relationships?",fa:"آیا این مشکل زمان‌بندی بر حضور، کار، تحصیل یا روابط شما اثر گذاشته است؟"}},
        ]},
        parasomnia: { assessment:{en:"A clinician can review episode timing, dream recall, injuries, medications and witness descriptions.",fa:"متخصص می‌تواند زمان رخداد، یادآوری رؤیا، آسیب‌ها، داروها و شرح شاهد را بررسی کند."}, resource:"unusual-behaviors-during-sleep", resourceLabel:{en:"Unusual behaviors during sleep",fa:"رفتارهای غیرمعمول هنگام خواب"}, questions:[
          {text:{en:"Do you shout, punch, kick, walk or perform complex actions while asleep?",fa:"آیا هنگام خواب فریاد می‌زنید، مشت یا لگد می‌زنید، راه می‌روید یا رفتارهای پیچیده انجام می‌دهید؟"}}, {text:{en:"Have you or a bed partner been injured or nearly injured during an episode?",fa:"آیا شما یا هم‌خوابتان هنگام این رخداد آسیب دیده یا در آستانه آسیب بوده‌اید؟"}}, {text:{en:"Do the movements appear connected to vivid or threatening dreams?",fa:"آیا حرکات با رؤیاهای واضح یا تهدیدآمیز مرتبط به نظر می‌رسند؟"}}, {text:{en:"Are the episodes new, worsening or occurring in later adulthood?",fa:"آیا این رخدادها جدید، رو به تشدید یا در سنین بالاتر آغاز شده‌اند؟"}},
        ]},
        movement: { assessment:{en:"A clinician can review the symptom pattern, medicines, iron status and conditions that may resemble restless legs.",fa:"متخصص می‌تواند الگوی علائم، داروها، وضعیت آهن و بیماری‌های مشابه پای بی‌قرار را بررسی کند."}, resource:"restless-legs-and-sleep-movements", resourceLabel:{en:"Restless legs and sleep movements",fa:"پای بی‌قرار و حرکات مرتبط با خواب"}, questions:[
          {text:{en:"Do you feel an urge to move your legs with uncomfortable sensations?",fa:"آیا همراه با احساس ناخوشایند، میل شدیدی به حرکت دادن پاها دارید؟"}}, {text:{en:"Do the sensations begin or become worse while resting?",fa:"آیا این احساسات هنگام استراحت آغاز یا بدتر می‌شوند؟"}}, {text:{en:"Does walking, stretching or moving provide temporary relief?",fa:"آیا راه رفتن، کشش یا حرکت موقتاً علائم را کاهش می‌دهد؟"}}, {text:{en:"Are symptoms mainly worse in the evening or at night?",fa:"آیا علائم عمدتاً عصر یا شب بدتر می‌شوند؟"}},
        ]},
      };
      const safety: Question[] = [
        { text:{en:"Are you 18 years of age or older?",fa:"آیا ۱۸ سال یا بیشتر دارید؟"}, help:{en:"This version has been designed only for adults.",fa:"این نسخه فقط برای بزرگسالان طراحی شده است."}, danger:"age" },
        { text:{en:"Are you currently struggling to breathe, experiencing chest pain, severe confusion or another medical emergency?",fa:"آیا اکنون دچار تنگی نفس، درد قفسه سینه، گیجی شدید یا وضعیت اورژانسی دیگری هستید؟"}, danger:"emergency" },
        { text:{en:"Have you fallen asleep while driving, or had a recent near miss because of sleepiness?",fa:"آیا هنگام رانندگی به خواب رفته‌اید یا اخیراً به دلیل خواب‌آلودگی در آستانه حادثه بوده‌اید؟"}, danger:"driving" },
        { text:{en:"Have sleep behaviors caused a significant injury or created an immediate risk to you or someone else?",fa:"آیا رفتارهای هنگام خواب باعث آسیب قابل توجه یا خطر فوری برای شما یا فرد دیگری شده‌اند؟"}, danger:"injury" },
      ];
      const router: Question[] = [
        {text:{en:"Do you regularly struggle to fall asleep, stay asleep or wake feeling restored?",fa:"آیا مرتباً برای به خواب رفتن، در خواب ماندن یا بیدار شدن با احساس شادابی مشکل دارید؟"},weights:{insomnia:2}},
        {text:{en:"Do you snore loudly, wake choking or have witnessed breathing pauses?",fa:"آیا خرخر بلند، بیدار شدن با احساس خفگی یا توقف تنفس مشاهده‌شده دارید؟"},weights:{breathing:3}},
        {text:{en:"Are you excessively sleepy during the day despite allowing enough time for sleep?",fa:"آیا با وجود زمان کافی برای خواب، در طول روز بیش از حد خواب‌آلود هستید؟"},weights:{sleepiness:2,breathing:1}},
        {text:{en:"Do you have sudden, difficult-to-resist sleep episodes?",fa:"آیا حملات ناگهانی و دشوار برای مقاومت در برابر خواب دارید؟"},weights:{sleepiness:3}},
        {text:{en:"Is your natural sleep schedule much earlier or later than work, school or family life requires?",fa:"آیا برنامه طبیعی خواب شما بسیار زودتر یا دیرتر از نیاز کار، تحصیل یا زندگی خانوادگی است؟"},weights:{circadian:3}},
        {text:{en:"Does shift work or an irregular schedule repeatedly disrupt your sleep?",fa:"آیا شیفت کاری یا برنامه نامنظم مرتباً خواب شما را مختل می‌کند؟"},weights:{circadian:2,insomnia:1}},
        {text:{en:"Do you walk, shout, act out dreams or perform unusual behaviors while asleep?",fa:"آیا هنگام خواب راه می‌روید، فریاد می‌زنید، رؤیاها را اجرا می‌کنید یا رفتارهای غیرمعمول دارید؟"},weights:{parasomnia:3}},
        {text:{en:"Do unpleasant leg sensations create an urge to move, especially at rest in the evening?",fa:"آیا احساس ناخوشایند پاها، به‌ویژه هنگام استراحت در عصر، میل به حرکت ایجاد می‌کند؟"},weights:{movement:3}},
        {text:{en:"Has a bed partner noticed repeated kicking or limb movements during your sleep?",fa:"آیا هم‌خوابتان متوجه لگد زدن یا حرکات تکراری اندام‌ها هنگام خواب شده است؟"},weights:{movement:2,parasomnia:1}},
        {text:{en:"Have these sleep concerns affected your mood, concentration, work, study or relationships?",fa:"آیا این مشکلات خواب بر خلق، تمرکز، کار، تحصیل یا روابط شما اثر گذاشته‌اند؟"},weights:{insomnia:1,sleepiness:1,circadian:1}},
      ];
      let mode: "safety" | "router" | "detail" = "safety", index = 0, primary: Category = "insomnia", detailScore = 0;
      let scores: Record<Category, number> = { insomnia:0, breathing:0, sleepiness:0, circadian:0, parasomnia:0, movement:0 };

      function reset() { mode="safety"; index=0; detailScore=0; scores={insomnia:0,breathing:0,sleepiness:0,circadian:0,parasomnia:0,movement:0}; resultPanel.classList.add("hidden"); questionPanel.classList.add("hidden"); intro.classList.remove("hidden"); stage.textContent=c({en:"Welcome",fa:"خوش آمدید"}); count.textContent=""; progress.style.width="0%"; }
      function button(label:string, value:string, accent=false) { const b=document.createElement("button"); b.type="button"; b.className=`choice-card rounded-2xl border px-5 py-4 text-start text-sm font-bold transition ${accent ? "border-krism-950 bg-krism-950 text-white hover:bg-krism-700" : "border-krism-border bg-white text-krism-950 hover:border-krism-600 hover:bg-krism-surface"}`; b.textContent=label; b.addEventListener("click",()=>answer(value)); return b; }
      function currentQuestions() { return mode==="safety" ? safety : mode==="router" ? router : details[primary].questions; }
      function renderQuestion() { const list=currentQuestions(), q=list[index]; intro.classList.add("hidden"); resultPanel.classList.add("hidden"); questionPanel.classList.remove("hidden"); stage.textContent=mode==="safety"?c({en:"Safety first",fa:"ابتدا ایمنی"}):mode==="router"?c({en:"Your sleep pattern",fa:"الگوی خواب شما"}):c(labels[primary]); questionText.textContent=c(q.text); questionHelp.textContent=q.help?c(q.help):c({en:"Choose the answer that best reflects your usual experience.",fa:"پاسخی را انتخاب کنید که تجربه معمول شما را بهتر نشان می‌دهد."}); count.textContent=`${index+1} / ${list.length}`; const base=mode==="safety"?0:mode==="router"?20:70, range=mode==="safety"?20:mode==="router"?50:25; progress.style.width=`${base+((index+1)/list.length)*range}%`; options.replaceChildren(button(c({en:"Yes",fa:"بله"}),"yes",true),button(c({en:"No",fa:"خیر"}),"no")); }
      function answer(value:string) { const q=currentQuestions()[index]; if(mode==="safety") { if(q.danger==="age"&&value==="no") return special("age"); if(q.danger!=="age"&&value==="yes") return special(q.danger||"urgent"); } else if(mode==="router"&&value==="yes") { for(const [cat,weight] of Object.entries(q.weights||{})) scores[cat as Category]+=weight||0; } else if(mode==="detail"&&value==="yes") detailScore++; index++; if(index<currentQuestions().length) return renderQuestion(); if(mode==="safety") {mode="router";index=0;return renderQuestion();} if(mode==="router") { const ordered=(Object.entries(scores) as [Category,number][]).sort((a,b)=>b[1]-a[1]); if(ordered[0][1]===0) return renderResult(undefined); primary=ordered[0][0];mode="detail";index=0;return renderQuestion(); } renderResult(primary); }
      function special(kind:string) { const data = kind==="age" ? {title:{en:"This check is not designed for children or adolescents.",fa:"این ارزیابی برای کودکان یا نوجوانان طراحی نشده است."},text:{en:"Please speak with a pediatrician or qualified pediatric sleep professional. Sleep concerns in younger people require age-specific assessment.",fa:"لطفاً با متخصص کودکان یا متخصص واجد شرایط خواب کودکان گفت‌وگو کنید. مشکلات خواب در سنین پایین به ارزیابی متناسب با سن نیاز دارند."}} : kind==="driving" ? {title:{en:"Prompt professional evaluation is recommended.",fa:"ارزیابی سریع حرفه‌ای توصیه می‌شود."},text:{en:"Do not drive or operate dangerous machinery while sleepy. Arrange prompt medical assessment and use a safe alternative for transportation.",fa:"هنگام خواب‌آلودگی رانندگی نکنید و با ماشین‌آلات خطرناک کار نکنید. برای ارزیابی سریع پزشکی اقدام کرده و از روش ایمن دیگری برای رفت‌وآمد استفاده کنید."}} : {title:{en:"Please seek urgent medical assistance.",fa:"لطفاً فوراً کمک پزشکی دریافت کنید."},text:{en:"This online check is not appropriate for an immediate safety or medical concern. Stop here and contact local emergency services or an appropriate urgent-care provider.",fa:"این ارزیابی آنلاین برای نگرانی فوری ایمنی یا پزشکی مناسب نیست. ارزیابی را متوقف کرده و با خدمات اورژانس محلی یا مرکز مراقبت فوری مناسب تماس بگیرید."}}; showMessage(c(data.title),c(data.text),true); }
      function showMessage(title:string,text:string,urgent=false) { questionPanel.classList.add("hidden"); intro.classList.add("hidden"); resultPanel.classList.remove("hidden"); stage.textContent=c({en:"Important next step",fa:"گام بعدی مهم"});count.textContent="";progress.style.width="100%";resultPanel.innerHTML=`<div class="flex h-16 w-16 items-center justify-center rounded-full ${urgent?"bg-[#fff0ea] text-[#b84e3f]":"bg-[#dcece5] text-krism-950"} text-3xl">!</div><h2 class="mt-7 text-3xl font-medium leading-tight text-krism-950">${title}</h2><p class="mt-5 max-w-2xl text-base leading-8 text-krism-muted">${text}</p><button type="button" data-reset class="mt-8 rounded-full border border-krism-border px-6 py-3 text-sm font-bold text-krism-950">${c({en:"Start over",fa:"شروع دوباره"})}</button>`; resultPanel.querySelector("[data-reset]")?.addEventListener("click",reset); }
      function renderResult(category?:Category) { if(!category) return showMessage(c({en:"No strong concern area was identified.",fa:"حوزه نگرانی مشخصی شناسایی نشد."}),c({en:"Continue healthy sleep habits and monitor your symptoms. If a concern persists, worsens or affects daily life, speak with a qualified health professional regardless of this result.",fa:"عادات سالم خواب را ادامه دهید و علائم خود را زیر نظر بگیرید. اگر مشکلی ادامه یافت، بدتر شد یا بر زندگی روزانه اثر گذاشت، صرف‌نظر از این نتیجه با متخصص سلامت واجد شرایط گفت‌وگو کنید."})); const d=details[category], prefix=lang==="fa"?"/fa":""; const domains=(Object.entries(scores) as [Category,number][]).filter(([,score])=>score>=2).sort((a,b)=>b[1]-a[1]).slice(0,3); const domainTags=domains.map(([domain])=>`<span class="inline-flex rounded-full bg-[#dcece5] px-4 py-2 text-xs font-bold text-krism-700">${c(labels[domain])}</span>`).join(""); questionPanel.classList.add("hidden");resultPanel.classList.remove("hidden");stage.textContent=c({en:"Your educational summary",fa:"خلاصه آموزشی شما"});count.textContent="";progress.style.width="100%"; resultPanel.innerHTML=`<p class="text-xs font-bold uppercase tracking-[.12em] text-krism-600">${c({en:"Relevant symptom areas",fa:"حوزه‌های مرتبط با علائم"})}</p><div class="mt-3 flex flex-wrap gap-2">${domainTags}</div><h2 class="mt-6 text-3xl font-medium leading-tight text-krism-950">${c({en:"A conversation with a sleep professional may be useful.",fa:"گفت‌وگو با متخصص خواب می‌تواند مفید باشد."})}</h2><p class="mt-5 max-w-2xl text-base leading-8 text-krism-muted">${c({en:"Your answers overlap with one or more areas of sleep medicine. This checklist does not calculate disease probability or establish a diagnosis; a clinician can assess other causes and decide whether testing is appropriate.",fa:"پاسخ‌های شما با یک یا چند حوزه پزشکی خواب هم‌پوشانی دارد. این چک‌لیست احتمال بیماری را محاسبه نمی‌کند و تشخیص نمی‌دهد؛ متخصص می‌تواند علل دیگر و نیاز به آزمایش را بررسی کند."})}</p><div class="mt-8 rounded-2xl bg-krism-surface p-6"><p class="text-xs font-bold uppercase tracking-[.12em] text-krism-600">${c({en:"Useful next discussion",fa:"موضوع مفید برای گفت‌وگو"})}</p><p class="mt-3 font-semibold text-krism-950">${c(d.assessment)}</p></div><div class="mt-6 flex flex-col gap-3 sm:flex-row"><a href="${prefix}/awareness/${d.resource}" class="rounded-full bg-krism-950 px-6 py-3 text-center text-sm font-bold text-white">${c(d.resourceLabel)}</a><button type="button" data-print class="rounded-full border border-krism-border px-6 py-3 text-sm font-bold text-krism-950">${c({en:"Print this summary",fa:"چاپ این خلاصه"})}</button><button type="button" data-reset class="rounded-full border border-krism-border px-6 py-3 text-sm font-bold text-krism-muted">${c({en:"Start over",fa:"شروع دوباره"})}</button></div><p class="mt-8 border-t border-krism-border pt-6 text-xs leading-6 text-krism-muted">${c({en:`Generated ${new Date().toLocaleDateString("en-US")}. Seek care sooner if symptoms create safety risks, worsen rapidly or cause severe daytime impairment. Do not drive while sleepy.`,fa:`تاریخ تهیه: ${new Date().toLocaleDateString("fa-IR")}. اگر علائم خطر ایمنی ایجاد می‌کنند، سریع بدتر می‌شوند یا اختلال شدید روزانه دارند، زودتر پیگیری کنید. هنگام خواب‌آلودگی رانندگی نکنید.`})}</p>`; resultPanel.querySelector("[data-reset]")?.addEventListener("click",reset);resultPanel.querySelector("[data-print]")?.addEventListener("click",()=>window.print()); }
      el<HTMLButtonElement>("#check-start").addEventListener("click",renderQuestion); el<HTMLButtonElement>("#check-back").addEventListener("click",reset);
    }
  </script>
</MainLayout>
