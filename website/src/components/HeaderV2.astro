---
import ScienceIcon from "./ScienceIcon.astro";

const currentPath = Astro.url.pathname;
const isPersian = currentPath === "/fa" || currentPath.startsWith("/fa/");
const englishPath = isPersian ? currentPath.replace(/^\/fa/, "") || "/" : currentPath;
const persianPath = currentPath === "/" ? "/fa" : `/fa${currentPath}`;
const pathFor = (path: string) => isPersian ? (path === "/" ? "/fa" : `/fa${path}`) : path;
const isActive = (path: string) => path === "/" ? currentPath === pathFor(path) : currentPath.startsWith(pathFor(path));

const links = [
  { path: "/about", en: "About", fa: "درباره ما", icon: "spark" },
  { path: "/board", en: "Research board", fa: "شورای پژوهشی", icon: "clinical" },
  { path: "/research", en: "Research", fa: "پژوهش", icon: "research" },
  { path: "/events", en: "Events", fa: "رویدادها", icon: "calendar" },
  { path: "/network", en: "Network", fa: "شبکه", icon: "network" },
  { path: "/resources", en: "Resources", fa: "منابع", icon: "book" },
  { path: "/awareness", en: "Sleep health", fa: "سلامت خواب", icon: "moon" },
] as const;
---

<header class:list={["site-header header-spectrum sticky top-0 z-50", isPersian && "header-spectrum--rtl"]}>
  <div class="header-statusbar hidden border-b border-white/8 text-white sm:block">
    <div class="page-wrap flex min-h-9 items-center justify-between gap-4 py-1.5 font-mono text-xs font-semibold uppercase tracking-[.08em]">
      <p class="flex min-w-0 items-center gap-2.5"><span class="status-beacon" aria-hidden="true"></span><span class="truncate">{isPersian ? "شبکه علمی و بالینی پزشکی خواب خراسان" : "KRISM // SLEEP SCIENCE NETWORK"}</span><span class="hidden text-white/65 xl:inline">{isPersian ? "پژوهش · آموزش · سلامت" : "RESEARCH · EDUCATION · HEALTH"}</span></p>
      <div class="flex shrink-0 items-center gap-4"><span class="hidden items-center gap-2 text-white/65 sm:flex"><span class="h-1 w-1 rounded-full bg-[#f6d46b]"></span>36.2605° N · 59.6168° E</span><a href={isPersian ? englishPath : persianPath} class="rounded-full border border-white/12 px-3 py-1 text-white/85 transition hover:border-[#68d7e8]/50 hover:text-white" lang={isPersian ? "en" : "fa"}>{isPersian ? "English" : "فارسی"}</a></div>
    </div>
  </div>

  <div class="header-shell border-b border-white/8">
    <div class="page-wrap header-main-grid h-[68px] items-center gap-4 sm:h-[76px]">
      <a href={pathFor("/")} class="header-brand group flex min-w-0 shrink items-center gap-3" aria-label={isPersian ? "صفحه اصلی KRISM" : "KRISM home"}>
        <span class="logo-orbit relative flex h-11 w-11 shrink-0 items-center justify-center sm:h-14 sm:w-14"><span class="absolute inset-1 rounded-full bg-krism-500/20 blur-md transition group-hover:bg-krism-500/35"></span><img src="/images/krism-logo.png" alt="" class="relative h-10 w-10 rounded-full border border-white/15 object-contain sm:h-12 sm:w-12" /></span>
        <div class="min-w-0"><div class="text-base font-bold leading-none tracking-[-.03em] text-white sm:text-[1.18rem]">KRISM</div><div class="mt-1 truncate text-[10px] font-semibold text-white/58 sm:font-mono sm:text-[9px] sm:uppercase sm:tracking-[.13em]">{isPersian ? "پزشکی خواب خراسان" : "Khorasan sleep medicine"}</div></div>
      </a>

      <nav class="header-nav hidden items-center justify-center xl:flex" aria-label={isPersian ? "ناوبری اصلی" : "Main navigation"}>
        {links.map((item, index) => (<a href={pathFor(item.path)} aria-current={isActive(item.path) ? "page" : undefined} class:list={["nav-pill group relative flex h-10 items-center px-3 text-[11px] font-bold transition", isActive(item.path) ? "text-white" : "text-white/55 hover:text-white"]}><span class="me-2 font-mono text-[8px] text-[#68d7e8]/45">0{index + 1}</span><span>{isPersian ? item.fa : item.en}</span></a>))}
      </nav>

      <div class="header-actions hidden shrink-0 items-center justify-end gap-2 xl:flex">
        <a href={pathFor("/contact")} class="header-icon-button flex h-10 w-10 items-center justify-center rounded-xl border border-white/12 bg-white/[.045] text-[#8cdbe3] transition hover:border-[#68d7e8]/45 hover:bg-white/10" aria-label={isPersian ? "تماس" : "Contact"}><ScienceIcon name="globe" class="h-[18px] w-[18px]" /></a>
        <a href={pathFor("/sleep-check")} class="group flex h-10 items-center gap-2 rounded-xl border border-[#68d7e8]/30 bg-[#68d7e8]/10 px-4 text-[11px] font-bold text-white transition hover:-translate-y-0.5 hover:border-[#68d7e8]/60 hover:bg-[#68d7e8]/18"><span>{isPersian ? "ارزیابی خواب" : "Sleep Check"}</span><span class="text-[#68d7e8] transition group-hover:translate-x-0.5">{isPersian ? "←" : "→"}</span></a>
      </div>

      <details class="header-menu group relative ms-auto xl:hidden">
        <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-xl border border-white/15 bg-white/[.055] text-white shadow-sm transition hover:border-[#68d7e8]/45 hover:bg-white/10" aria-label={isPersian ? "باز کردن منو" : "Open menu"}><span class="menu-glyph relative block h-4 w-5"><i></i><i></i><i></i></span></summary>
        <div class="header-menu-panel absolute end-0 top-14 w-[min(88vw,22rem)] overflow-hidden rounded-2xl border border-white/10 bg-[#071c27]/98 text-white shadow-2xl shadow-black/35 backdrop-blur-xl sm:top-16">
          <div class="flex items-center justify-between border-b border-white/10 px-4 py-4"><div><p class="font-mono text-[10px] font-bold tracking-[.14em] text-[#68d7e8]">KRISM / MENU</p><p class="mt-1 text-sm font-semibold text-white/85">{isPersian ? "پزشکی خواب خراسان" : "Khorasan sleep medicine"}</p></div><ScienceIcon name="network" class="h-7 w-7 text-[#68d7e8]" /></div>
          <nav class="grid gap-1 p-2" aria-label={isPersian ? "ناوبری موبایل" : "Mobile navigation"}>{links.map((item) => (<a href={pathFor(item.path)} aria-current={isActive(item.path) ? "page" : undefined} class:list={["flex min-h-11 items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold transition", isActive(item.path) ? "bg-[#68d7e8]/14 text-white" : "text-white/72 hover:bg-white/7 hover:text-white"]}><ScienceIcon name={item.icon} class="h-5 w-5 shrink-0 text-[#68d7e8]" /><span>{isPersian ? item.fa : item.en}</span></a>))}</nav>
          <div class="grid grid-cols-2 gap-2 border-t border-white/10 p-3"><a href={pathFor("/sleep-check")} class="rounded-xl bg-[#68d7e8] px-3 py-3 text-center text-xs font-bold text-[#061923]">{isPersian ? "ارزیابی خواب" : "Sleep Check"}</a><a href={pathFor("/contact")} class="rounded-xl border border-white/15 px-3 py-3 text-center text-xs font-bold text-white">{isPersian ? "تماس" : "Contact"}</a><a href={isPersian ? englishPath : persianPath} class="col-span-2 rounded-xl px-3 py-2 text-center text-xs font-semibold text-white/62 hover:bg-white/5" lang={isPersian ? "en" : "fa"}>{isPersian ? "English version" : "نسخه فارسی"}</a></div>
        </div>
      </details>
    </div>
  </div>
</header>
