---
import ScienceIcon from "./ScienceIcon.astro";
interface Props { eyebrow: string; title: string; description: string; icon?: "research" | "calendar" | "book" | "moon" | "network" | "clinical" | "spark"; meta?: Array<{ label: string; value: string }> }
const { eyebrow, title, description, icon = "spark", meta = [] } = Astro.props;
---

<section class="record-hero tech-grid-dark relative overflow-hidden bg-krism-950 text-white">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#68d7e8]/70 to-transparent"></div>
  <div class="absolute -end-24 -top-32 h-96 w-96 rounded-full bg-[#287789]/25 blur-3xl"></div>
  <div class="page-wrap relative grid gap-12 py-20 lg:grid-cols-[1.15fr_.85fr] lg:items-center lg:py-28">
    <div>
      <div class="flex items-center gap-4"><p class="tech-label text-[#68d7e8]">KRISM / RECORD</p><span class="h-px w-10 bg-white/20"></span><p class="text-xs font-bold uppercase tracking-[.11em] text-[#f6d46b]">{eyebrow}</p></div>
      <h1 class="mt-7 max-w-4xl text-5xl font-medium leading-[1.02] tracking-[-.04em] sm:text-6xl lg:text-7xl">{title}</h1>
      <p class="mt-7 max-w-2xl text-base leading-8 text-white/65 lg:text-lg">{description}</p>
      {meta.length > 0 && <div class="mt-9 grid max-w-2xl gap-2 sm:grid-cols-3">{meta.map((item) => <div class="rounded-2xl border border-white/10 bg-white/[.05] p-4"><p class="tech-label text-[#68d7e8]/80">{item.label}</p><p class="mt-2 text-sm font-semibold text-white/85">{item.value}</p></div>)}</div>}
    </div>
    <div class="record-hero-visual relative mx-auto flex aspect-square w-full max-w-[22rem] items-center justify-center rounded-[2.5rem] border border-white/12 bg-white/[.035]">
      <div class="absolute inset-8 rounded-full border border-[#68d7e8]/20"></div><div class="absolute inset-16 rounded-full border border-dashed border-[#68d7e8]/25"></div>
      <span class="relative flex h-28 w-28 items-center justify-center rounded-[2rem] bg-[#cbe8ee] text-krism-950 shadow-[0_0_0_1.5rem_rgba(104,215,232,.06),0_0_4rem_rgba(104,215,232,.24)]"><ScienceIcon name={icon} class="h-14 w-14" /></span>
      <span class="absolute left-[14%] top-[17%] h-2 w-2 rounded-full bg-[#68d7e8] shadow-[0_0_1rem_#68d7e8]"></span><span class="absolute bottom-[18%] right-[16%] h-2 w-2 rounded-full bg-[#f6d46b] shadow-[0_0_1rem_#f6d46b]"></span>
      <svg class="absolute inset-0 h-full w-full text-[#68d7e8]/35" viewBox="0 0 400 400" aria-hidden="true"><path d="M35 270h75l12-2 10-45 15 96 17-130 17 80h72l12-2 10-38 16 76 14-116 18 78h64" fill="none" stroke="currentColor" stroke-width="1.4" stroke-dasharray="5 5" /></svg>
    </div>
  </div>
</section>
