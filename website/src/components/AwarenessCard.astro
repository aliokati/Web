---
import type { AwarenessArticle } from "../data/awareness";
import ScienceIcon from "./ScienceIcon.astro";

interface Props {
  article: AwarenessArticle;
  lang?: "en" | "fa";
}

const { article, lang = "en" } = Astro.props;
const fa = lang === "fa";
---

<a
  href={`${fa ? "/fa" : ""}/awareness/${article.slug}`}
  class="content-card group block min-h-full p-7"
>
  <div class="flex items-start justify-between gap-4">
    <span class="flex items-center gap-3"><span class="icon-badge"><ScienceIcon name="moon" class="h-6 w-6" /></span><span class="card-kicker">{article.category}</span></span>

    <span class="flex h-10 w-10 items-center justify-center rounded-full border border-krism-border text-sm text-krism-muted transition group-hover:border-krism-950 group-hover:bg-krism-950 group-hover:text-white">
      {fa ? "←" : "→"}
    </span>
  </div>

  <h2 class="mt-8 text-2xl font-medium leading-tight tracking-tight text-krism-950">
    {article.title}
  </h2>

  <p class="mt-4 text-sm leading-7 text-krism-muted">
    {article.excerpt}
  </p>

  <div class="card-action mt-7 border-t border-krism-border/70 pt-5">
    {fa ? "مطالعه مقاله" : "Read article"} <span>{fa ? "←" : "→"}</span>
  </div>
</a>
