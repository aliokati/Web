---
import type { ResearchItem } from "../data/research";

interface Props {
  project: ResearchItem;
}

const { project } = Astro.props;
---

<a
  href={`/research/${project.slug}`}
  class="group soft-card block p-7 transition duration-300 hover:-translate-y-1"
>

  <div class="flex items-start justify-between gap-4">

    <span class="text-xs font-semibold uppercase tracking-[0.15em] text-krism-600">
      {project.type}
    </span>

    <span class="rounded-full bg-krism-surface px-3 py-1 text-xs text-krism-muted">
      {project.registrationOpen}
    </span>

  </div>


  <h2 class="mt-8 text-2xl font-medium leading-tight text-krism-950 group-hover:text-krism-600">
    {project.title}
  </h2>


  <p class="mt-3 text-sm leading-7 text-krism-muted">
    {project.description}
  </p>


  <div class="mt-7 flex items-center justify-between text-sm">

    <span class="text-krism-muted">
      {project.date}
    </span>

    <span class="font-semibold text-krism-600">
      View project →
    </span>

  </div>

</a>
