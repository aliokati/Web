---
import type { ResearchItem } from "../data/research";
import ScienceIcon from "./ScienceIcon.astro";

interface Props {
  project: ResearchItem;
  lang?: "en" | "fa";
}

const { project, lang = "en" } = Astro.props;
const fa = lang === "fa";
---

<a
  href={`${fa ? "/fa" : ""}/research/${project.slug}`}
  class="content-card group block min-h-full p-7"
>

  <div class="flex items-start justify-between gap-4">

    <span class="flex items-center gap-3"><span class="icon-badge"><ScienceIcon name="research" class="h-6 w-6" /></span><span class="card-kicker">{project.type}</span></span>

    <span class="rounded-full bg-krism-surface px-3 py-1 text-xs text-krism-muted">
      {project.statusLabel ?? (fa ? "پروژه پژوهشی" : "Research project")}
    </span>

  </div>


  <h2 class="mt-8 text-2xl font-medium leading-tight text-krism-950 group-hover:text-krism-600">
    {project.title}
  </h2>


  <p class="mt-3 text-sm leading-7 text-krism-muted">
    {project.description}
  </p>


  <div class="mt-8 flex items-center justify-between border-t border-krism-border/70 pt-5 text-sm">

    <span class="text-krism-muted">
      {project.date}
    </span>

    <span class="card-action">
      {fa ? "مشاهده پروژه" : "View project"} <span>{fa ? "←" : "→"}</span>
    </span>

  </div>

</a>
