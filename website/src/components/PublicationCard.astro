---
import type { Publication } from "../data/publications";
import ScienceIcon from "./ScienceIcon.astro";

interface Props {
  publication: Publication;
  lang?: "en" | "fa";
}

const { publication, lang = "en" } = Astro.props;
const fa = lang === "fa";

---
<article
  class="content-card mb-5 p-7"
>
  <div class="flex items-center gap-3"><span class="icon-badge"><ScienceIcon name="research" class="h-6 w-6" /></span><p class="card-kicker">{publication.category ?? (fa ? "انتشار علمی" : "Publication")}</p></div>

  <h2 class="mt-5 text-2xl font-medium leading-tight text-krism-950">
    {publication.title}
  </h2>

  <p class="mt-3 text-sm leading-7 text-krism-muted">{publication.authors}</p>
  <p class="mt-1 text-sm leading-7 text-krism-muted">{publication.journal} · {publication.year}</p>

  {
    publication.url ? (
      <a
        href={publication.url}
        target="_blank"
        rel="noopener noreferrer"
        class="card-action mt-6"
      >
        {fa ? "مطالعه مقاله ←" : "Open publication →"}
      </a>
    ) : (
      <span class="mt-6 inline-block text-sm font-medium text-krism-muted">
        {fa ? "پیوند در دسترس نیست" : "Link unavailable"}
      </span>
    )
  }
</article>
