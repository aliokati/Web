---
import PageHero from "./PageHero.astro";
import ScienceIcon from "./ScienceIcon.astro";
interface Props { lang?: "en" | "fa"; }
const { lang = "en" } = Astro.props;
const fa = lang === "fa";
const t = (en:string,faText:string) => fa ? faText : en;
const prefix = fa ? "/fa" : "";
const pillars = [
  ["research", t("Research", "پژوهش"), t("Connect investigators, make regional priorities visible and support responsible collaboration.", "ارتباط پژوهشگران، نمایان‌کردن اولویت‌های منطقه‌ای و پشتیبانی از همکاری مسئولانه.")],
  ["book", t("Education", "آموزش"), t("Create pathways for continuing education, meetings and multidisciplinary exchange.", "ایجاد مسیرهای آموزش مداوم، نشست‌های علمی و تبادل چندرشته‌ای.")],
  ["moon", t("Public sleep health", "سلامت عمومی خواب"), t("Translate evidence into careful, understandable information without replacing clinical care.", "ترجمه شواهد به اطلاعات دقیق و قابل‌فهم، بدون جایگزینی مراقبت بالینی.")],
  ["network", t("Professional network", "شبکه حرفه‌ای"), t("Help clinicians, researchers and institutions discover one another and work across disciplines.", "کمک به متخصصان، پژوهشگران و مؤسسات برای شناخت و همکاری میان‌رشته‌ای.")],
] as const;
---

<PageHero eyebrow={t("About KRISM", "درباره KRISM")} icon="network" title={t("A regional platform for sleep medicine.", "بستری منطقه‌ای برای پزشکی خواب")} description={t("KRISM connects sleep-health research, professional education, public understanding and multidisciplinary collaboration across Khorasan.", "KRISM پژوهش سلامت خواب، آموزش حرفه‌ای، آگاهی عمومی و همکاری چندرشته‌ای را در خراسان به هم پیوند می‌دهد.")} />

<section class="surface-paper"><div class="page-wrap py-20 lg:py-28"><div class="grid gap-12 lg:grid-cols-[.72fr_1.28fr]"><div><p class="tech-label text-krism-600">KRISM / IDENTITY</p><h2 class="mt-6 text-4xl font-medium leading-tight text-krism-950">{t("Built to make regional expertise easier to find, share and use.", "برای دیده‌شدن، به‌اشتراک‌گذاری و استفاده بهتر از تخصص منطقه‌ای.")}</h2></div><div class="grid gap-5 sm:grid-cols-2"><div class="rounded-[1.6rem] border border-krism-border bg-white/72 p-7 sm:col-span-2"><p class="text-lg leading-9 text-krism-muted">{t("The Khorasan sleep-medicine network is designed as a practical meeting point: one place for verified professional profiles, active research, scientific events, trusted resources and responsible public education.", "شبکه پزشکی خواب خراسان به‌عنوان یک نقطه اتصال کاربردی طراحی شده است: فضایی واحد برای پروفایل‌های حرفه‌ای تأییدشده، پژوهش‌های فعال، رویدادهای علمی، منابع معتبر و آموزش عمومی مسئولانه.")}</p></div><div class="rounded-[1.6rem] bg-krism-950 p-7 text-white"><p class="tech-label text-[#68d7e8]">{t("Geographic scope", "دامنه جغرافیایی")}</p><p class="mt-6 text-2xl font-medium">{t("Khorasan region, Iran", "منطقه خراسان، ایران")}</p><p class="mt-4 text-sm leading-7 text-white/58">{t("Regional work connected to the national and international sleep-medicine community.", "فعالیت منطقه‌ای در ارتباط با جامعه ملی و بین‌المللی پزشکی خواب.")}</p></div><div class="rounded-[1.6rem] border border-krism-border bg-[#dce9e6] p-7"><p class="tech-label text-krism-600">{t("Institutional record", "پیشینه سازمانی")}</p><p class="mt-6 text-xl font-semibold text-krism-950">{t("Formal history pending verification", "در انتظار تأیید پیشینه رسمی")}</p><p class="mt-4 text-sm leading-7 text-krism-muted">{t("Founding date, legal status and leadership chronology will be published after confirmation by KRISM.", "تاریخ تأسیس، وضعیت رسمی و توالی مدیریت پس از تأیید KRISM منتشر می‌شود.")}</p></div></div></div></div></section>

<section class="surface-night text-white"><div class="page-wrap py-20 lg:py-28"><div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end"><div><p class="tech-label text-[#f6d46b]">{t("Operating model", "مدل فعالیت")}</p><h2 class="mt-5 max-w-3xl text-4xl font-medium sm:text-5xl">{t("Four connected areas of work.", "چهار حوزه فعالیت به‌هم‌پیوسته")}</h2></div><p class="max-w-xl text-sm leading-7 text-white/58">{t("Each area is managed through the same bilingual publishing and review workflow, keeping public claims separate from drafts and unverified material.", "هر حوزه با همان فرایند دوزبانه انتشار و بازبینی مدیریت می‌شود تا ادعاهای عمومی از پیش‌نویس‌ها و محتوای تأییدنشده جدا بماند.")}</p></div><div class="mt-12 grid gap-5 md:grid-cols-2">{pillars.map(([icon,title,text],index) => <article class="editorial-card rounded-[1.6rem] p-7"><div class="flex items-center justify-between"><span class="icon-badge"><ScienceIcon name={icon} class="h-6 w-6" /></span><span class="font-mono text-xs text-white/35">0{index+1}</span></div><h3 class="mt-8 text-2xl font-medium">{title}</h3><p class="mt-4 text-sm leading-7">{text}</p></article>)}</div></div></section>

<section class="surface-mineral"><div class="page-wrap py-20 lg:py-28"><div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr]"><div><p class="tech-label text-krism-600">{t("How we work", "شیوه فعالیت")}</p><h2 class="mt-6 text-4xl font-medium text-krism-950">{t("Evidence, review, then public value.", "شواهد، بازبینی، سپس ارزش عمومی")}</h2></div><div class="grid gap-4 sm:grid-cols-3">{[["01",t("Source", "منبع"),t("Start with attributable evidence and clearly owned information.", "شروع با شواهد قابل استناد و اطلاعات با مالکیت روشن.")],["02",t("Review", "بازبینی"),t("Use named editorial or clinical review before health content is published.", "بازبینی تحریریه یا بالینی مشخص پیش از انتشار محتوای سلامت.")],["03",t("Connect", "ارتباط"),t("Turn approved material into useful pathways for people and professionals.", "تبدیل محتوای تأییدشده به مسیرهای کاربردی برای مردم و متخصصان.")]].map(([n,title,text]) => <div class="rounded-2xl border border-krism-border bg-white/72 p-6"><p class="font-mono text-xs font-bold text-krism-600">STEP / {n}</p><h3 class="mt-8 text-xl font-semibold text-krism-950">{title}</h3><p class="mt-3 text-sm leading-7 text-krism-muted">{text}</p></div>)}</div></div></div></section>

<section class="surface-teal text-white"><div class="page-wrap grid gap-6 py-16 lg:grid-cols-3"><a href={`${prefix}/board`} class="rounded-[1.5rem] border border-white/12 bg-white/5 p-7 transition hover:bg-white/10"><ScienceIcon name="clinical" class="h-7 w-7 text-[#68d7e8]" /><h2 class="mt-6 text-2xl font-medium">{t("Research board", "شورای پژوهشی")}</h2><p class="mt-3 text-sm leading-7 text-white/58">{t("Scientific leadership, expertise and scholarly profiles.", "رهبری علمی، تخصص‌ها و پروفایل‌های دانشگاهی.")}</p></a><a href={`${prefix}/standards`} class="rounded-[1.5rem] border border-white/12 bg-white/5 p-7 transition hover:bg-white/10"><ScienceIcon name="shield" class="h-7 w-7 text-[#68d7e8]" /><h2 class="mt-6 text-2xl font-medium">{t("Editorial standards", "اصول محتوایی")}</h2><p class="mt-3 text-sm leading-7 text-white/58">{t("Review, privacy, sourcing and clinical boundaries.", "بازبینی، حریم خصوصی، منابع و مرزهای بالینی.")}</p></a><a href={`${prefix}/affiliations`} class="rounded-[1.5rem] border border-white/12 bg-white/5 p-7 transition hover:bg-white/10"><ScienceIcon name="globe" class="h-7 w-7 text-[#68d7e8]" /><h2 class="mt-6 text-2xl font-medium">{t("Scientific ecosystem", "زیست‌بوم علمی")}</h2><p class="mt-3 text-sm leading-7 text-white/58">{t("Professional organizations and peer-reviewed journals.", "سازمان‌های حرفه‌ای و مجلات داوری‌شده.")}</p></a></div></section>
