---
import PageHero from "./PageHero.astro";
import ScienceIcon from "./ScienceIcon.astro";
interface Props { lang?: "en" | "fa"; }
const { lang = "en" } = Astro.props;
const fa = lang === "fa";
const t = (en:string,faText:string) => fa ? faText : en;
const channels = [
  { label:t("Email","ایمیل"), value:import.meta.env.PUBLIC_CONTACT_EMAIL, href:import.meta.env.PUBLIC_CONTACT_EMAIL ? `mailto:${import.meta.env.PUBLIC_CONTACT_EMAIL}` : "", icon:"globe" },
  { label:t("Phone","تلفن"), value:import.meta.env.PUBLIC_CONTACT_PHONE, href:import.meta.env.PUBLIC_CONTACT_PHONE ? `tel:${import.meta.env.PUBLIC_CONTACT_PHONE}` : "", icon:"clinical" },
  { label:"WhatsApp", value:import.meta.env.PUBLIC_WHATSAPP_URL ? t("Open conversation","شروع گفتگو") : "", href:import.meta.env.PUBLIC_WHATSAPP_URL, icon:"network" },
  { label:"Telegram", value:import.meta.env.PUBLIC_TELEGRAM_URL ? t("Open channel","مشاهده کانال") : "", href:import.meta.env.PUBLIC_TELEGRAM_URL, icon:"network" },
  { label:"LinkedIn", value:import.meta.env.PUBLIC_LINKEDIN_URL ? t("Professional profile","پروفایل حرفه‌ای") : "", href:import.meta.env.PUBLIC_LINKEDIN_URL, icon:"research" },
  { label:"Instagram", value:import.meta.env.PUBLIC_INSTAGRAM_URL ? t("Public updates","اطلاع‌رسانی عمومی") : "", href:import.meta.env.PUBLIC_INSTAGRAM_URL, icon:"spark" },
] as const;
const activeChannels = channels.filter((item) => item.href);
const address = import.meta.env.PUBLIC_CONTACT_ADDRESS;
---

<PageHero eyebrow={t("Contact", "تماس")} icon="globe" title={t("Connect with KRISM.", "با KRISM در ارتباط باشید")} description={t("One secure route for scientific collaboration, education, professional networking, media and organizational inquiries.", "یک مسیر امن برای همکاری علمی، آموزش، شبکه حرفه‌ای، رسانه و درخواست‌های سازمانی.")} />

<section class="surface-mineral"><div class="page-wrap py-20 lg:py-28"><div class="grid gap-10 lg:grid-cols-[.78fr_1.22fr]"><aside><p class="tech-label text-krism-600">{t("Contact channels", "راه‌های ارتباطی")}</p><h2 class="mt-5 text-4xl font-medium text-krism-950">{t("Choose the right route.", "مسیر مناسب را انتخاب کنید")}</h2><p class="mt-5 text-sm leading-8 text-krism-muted">{t("The form is the preferred route because it creates a reference number and keeps the inquiry inside the private administration area.", "فرم مسیر پیشنهادی است؛ زیرا شماره پیگیری ایجاد می‌کند و درخواست را در بخش خصوصی مدیریت نگه می‌دارد.")}</p><div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-1">{activeChannels.length ? activeChannels.map((item) => <a href={item.href} target={item.href.startsWith("http") ? "_blank" : undefined} rel={item.href.startsWith("http") ? "noreferrer" : undefined} class="flex items-center gap-4 rounded-2xl border border-krism-border bg-white/72 p-4 transition hover:-translate-y-0.5 hover:border-krism-500/40"><span class="icon-badge h-11 w-11 shrink-0"><ScienceIcon name={item.icon} class="h-5 w-5" /></span><span><b class="block text-sm text-krism-950">{item.label}</b><small class="mt-1 block break-all text-xs text-krism-muted">{item.value}</small></span></a>) : <div class="rounded-2xl border border-dashed border-krism-border bg-white/60 p-5"><p class="text-sm font-semibold text-krism-950">{t("Official external channels awaiting confirmation", "راه‌های ارتباطی رسمی در انتظار تأیید")}</p><p class="mt-2 text-xs leading-6 text-krism-muted">{t("Use the secure inquiry form in the meantime.", "تا آن زمان از فرم امن درخواست استفاده کنید.")}</p></div>}</div>{address && <div class="mt-4 rounded-2xl border border-krism-border bg-white/72 p-5"><p class="tech-label text-krism-600">{t("Office", "دفتر")}</p><p class="mt-3 text-sm leading-7 text-krism-950">{address}</p></div>}<div class="mt-5 rounded-2xl bg-krism-950 p-5 text-white"><p class="text-sm font-semibold">{t("Health and emergency boundary", "مرز سلامت و فوریت")}</p><p class="mt-2 text-xs leading-6 text-white/55">{t("KRISM contact channels do not provide diagnosis, urgent care or emergency response. Contact local emergency services for immediate danger.", "راه‌های ارتباطی KRISM برای تشخیص، مراقبت فوری یا پاسخ اورژانسی نیستند. در خطر فوری با خدمات اورژانس محلی تماس بگیرید.")}</p></div></aside>

<div class="rounded-[1.8rem] border border-krism-border bg-white/78 p-6 shadow-[0_28px_80px_rgba(5,31,41,.12)] backdrop-blur sm:p-9"><div class="flex items-start gap-4"><span class="icon-badge"><ScienceIcon name="globe" class="h-6 w-6" /></span><div><p class="tech-label text-krism-600">{t("Secure inquiry", "درخواست امن")}</p><h2 class="mt-3 text-3xl font-medium text-krism-950">{t("Send a message", "ارسال پیام")}</h2></div></div><form class="contact-system-form mt-8 grid gap-5 sm:grid-cols-2" data-contact-form data-locale={lang}><label><span class="form-label">{t("Name", "نام")}</span><input name="name" required minlength="2" maxlength="120" autocomplete="name" class="form-control" /></label><label><span class="form-label">{t("Email", "ایمیل")}</span><input name="email" type="email" required maxlength="254" autocomplete="email" class="form-control" /></label><label><span class="form-label">{t("Organization", "سازمان")}</span><input name="organization" maxlength="160" autocomplete="organization" class="form-control" /></label><label><span class="form-label">{t("Role / specialty", "سمت / تخصص")}</span><input name="role" maxlength="120" autocomplete="organization-title" class="form-control" /></label><label class="sm:col-span-2"><span class="form-label">{t("Subject", "موضوع")}</span><select name="subject" required class="form-control"><option value="">{t("Choose a subject", "موضوع را انتخاب کنید")}</option><option>{t("Research collaboration", "همکاری پژوهشی")}</option><option>{t("Education or event", "آموزش یا رویداد")}</option><option>{t("Professional network", "شبکه حرفه‌ای")}</option><option>{t("Media inquiry", "درخواست رسانه‌ای")}</option><option>{t("Website correction", "اصلاح محتوای وب‌سایت")}</option><option>{t("General inquiry", "درخواست عمومی")}</option></select></label><label class="sm:col-span-2"><span class="form-label">{t("Message", "پیام")}</span><textarea name="message" required minlength="20" maxlength="5000" rows="7" class="form-control resize-y"></textarea></label><label class="hidden" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label><label class="sm:col-span-2 flex items-start gap-3 rounded-xl border border-krism-border bg-krism-surface/70 p-4"><input name="consent" type="checkbox" required class="mt-1 h-4 w-4 accent-krism-700" /><span class="text-xs leading-6 text-krism-muted">{t("I agree that KRISM may store this information to respond to my inquiry. I have not included medical records or urgent health information.", "موافقم KRISM این اطلاعات را برای پاسخ‌گویی به درخواست من ذخیره کند. مدارک پزشکی یا اطلاعات فوری سلامت وارد نکرده‌ام.")}</span></label><div class="sm:col-span-2 flex flex-col gap-3 sm:flex-row sm:items-center"><button type="submit" class="rounded-full bg-krism-950 px-7 py-3.5 text-sm font-bold text-white transition hover:bg-krism-700">{t("Submit inquiry", "ثبت درخواست")}</button><p class="form-status text-sm font-semibold text-krism-700" role="status" aria-live="polite"></p></div></form><p class="mt-6 text-xs leading-6 text-krism-muted">{t("Submissions are visible only to the site administrator, retained for the configured period, and can be deleted from the private administration panel.", "درخواست‌ها فقط برای مدیر سایت قابل مشاهده‌اند، برای مدت تنظیم‌شده نگهداری می‌شوند و از پنل خصوصی مدیریت قابل حذف‌اند.")}</p></div></div></div></section>

<script>
  document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => form.addEventListener("submit", async (event) => {
    event.preventDefault();
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const status = form.querySelector<HTMLElement>(".form-status");
    if (!button || !status || !form.reportValidity()) return;
    button.disabled = true; status.textContent = form.dataset.locale === "fa" ? "در حال ارسال…" : "Submitting…";
    const payload = Object.fromEntries(new FormData(form).entries()) as Record<string, unknown>;
    payload.consent = Boolean(form.querySelector<HTMLInputElement>('[name="consent"]')?.checked); payload.locale = form.dataset.locale || "en";
    try { const response = await fetch("/api/forms/contact", { method:"POST", headers:{"Content-Type":"application/json"}, body:JSON.stringify(payload) }); const data = await response.json(); if (!response.ok) throw new Error(data.error || "Submission failed"); form.reset(); status.textContent = form.dataset.locale === "fa" ? `درخواست ثبت شد. کد پیگیری: ${data.reference}` : `Received. Reference: ${data.reference}`; }
    catch (error) { status.textContent = error instanceof Error ? error.message : "Submission failed"; }
    finally { button.disabled = false; }
  }));
</script>
