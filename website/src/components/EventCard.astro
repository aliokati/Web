---
import type { EventItem } from "../data/events";
import ScienceIcon from "./ScienceIcon.astro";

interface Props {
  event: EventItem;
  lang?: "en" | "fa";
}

const { event, lang = "en" } = Astro.props;
const fa = lang === "fa";

const date = new Date(event.date);

const day = date.toLocaleDateString(fa ? "fa-IR" : "en-US", {
  day: "2-digit",
});

const month = date.toLocaleDateString(fa ? "fa-IR" : "en-US", {
  month: "short",
});

const year = date.toLocaleDateString(fa ? "fa-IR" : "en-US", {
  year: "numeric",
});
---

<a
  href={`${fa ? "/fa" : ""}/events/${event.slug}`}
  class="content-card group flex min-h-full flex-col p-6"
>

  <div class="flex gap-6">

    <div
      class="card-date-panel flex h-24 w-24 shrink-0 flex-col items-center justify-center rounded-[1.25rem] text-white"
    >
      <ScienceIcon name="calendar" class="mb-1 h-4 w-4 text-[#68d7e8]" />
      <span class="text-2xl font-semibold">
        {day}
      </span>

      <span class="text-xs uppercase tracking-wider text-slate-300">
        {month} {year}
      </span>
    </div>


    <div class="min-w-0">

      <p class="card-kicker">
        {event.type}
      </p>

      <h3 class="mt-2 text-xl font-medium leading-tight text-krism-950 group-hover:text-krism-600">
        {event.title}
      </h3>

      <p class="mt-2 text-sm text-krism-muted">
        {event.location}
      </p>

    </div>

  </div>


  <p class="mt-6 flex-1 text-sm leading-7 text-krism-muted">
    {event.description}
  </p>


  <div class="mt-7 flex items-center justify-between border-t border-krism-border/70 pt-5">

    <span class="card-action">
      {fa ? "مشاهده رویداد" : "View event"} <span>{fa ? "←" : "→"}</span>
    </span>

    {
      event.registrationOpen && (
        <span class="rounded-full bg-krism-surface px-3 py-1 text-xs font-medium text-krism-600">
          {fa ? "ثبت‌نام باز" : "Registration open"}
        </span>
      )
    }

  </div>

</a>
