---
import type { EventItem } from "../data/events";

interface Props {
  event: EventItem;
}

const { event } = Astro.props;

const date = new Date(event.date);

const day = date.toLocaleDateString("en-US", {
  day: "2-digit",
});

const month = date.toLocaleDateString("en-US", {
  month: "short",
});

const year = date.toLocaleDateString("en-US", {
  year: "numeric",
});
---

<a
  href={`/events/${event.slug}`}
  class="group soft-card block p-6 transition duration-300 hover:-translate-y-1"
>

  <div class="flex gap-6">

    <div
      class="flex h-20 w-20 shrink-0 flex-col items-center justify-center rounded-[1.15rem] bg-krism-950 text-white"
    >
      <span class="text-2xl font-semibold">
        {day}
      </span>

      <span class="text-xs uppercase tracking-wider text-slate-300">
        {month} {year}
      </span>
    </div>


    <div class="min-w-0">

      <p class="text-xs font-semibold uppercase tracking-[0.15em] text-krism-600">
        {event.type}
      </p>

      <h3 class="mt-2 text-xl font-medium leading-tight text-krism-950 group-hover:text-krism-600">
        {event.title}
      </h3>

      <p class="mt-2 text-sm text-krism-muted">
        {event.location}
      </p>

    </div>

  </div>


  <p class="mt-6 text-sm leading-6 text-krism-muted">
    {event.description}
  </p>


  <div class="mt-6 flex items-center justify-between">

    <span class="text-sm font-semibold text-krism-600">
      View event →
    </span>

    {
      event.registrationOpen && (
        <span class="rounded-full bg-krism-surface px-3 py-1 text-xs font-medium text-krism-600">
          Registration open
        </span>
      )
    }

  </div>

</a>
