---
import type { NetworkMember } from "../data/network";
import ScienceIcon from "./ScienceIcon.astro";

interface Props {
  member: NetworkMember;
  lang?: "en" | "fa";
}

const { member, lang = "en" } = Astro.props;
const fa = lang === "fa";
const memberIcon: "clinical" | "research" | "network" = member.type === "Professional" ? "clinical" : member.type === "Researcher" ? "research" : "network";
const typeLabels: Record<string, string> = { Professional: "متخصص", Researcher: "پژوهشگر", Organization: "سازمان", Institution: "مؤسسه" };
---

<article
  class="content-card flex min-h-[22rem] flex-col p-7"
>
  <div class="flex items-start justify-between gap-4">
    <span class="flex items-center gap-3"><span class="icon-badge"><ScienceIcon name={memberIcon} class="h-6 w-6" /></span><span class="card-kicker">{fa ? (typeLabels[member.type] ?? member.type) : member.type}</span></span>

    {member.city && (
      <span class="text-xs text-krism-muted">
        {member.city}
      </span>
    )}
  </div>

  <h2 class="mt-7 text-2xl font-medium leading-tight text-krism-950">
    {member.name}
  </h2>

  {member.specialty && (
    <p class="mt-2 text-sm font-medium text-krism-600">
      {member.specialty}
    </p>
  )}

  {member.affiliation && (
    <p class="mt-2 text-sm text-krism-muted">
      {member.affiliation}
    </p>
  )}

  <p class="mt-5 text-sm leading-7 text-krism-muted">
    {member.description}
  </p>

  {member.website && (
    <a
      href={member.website}
      target="_blank"
      rel="noopener noreferrer"
      class="card-action mt-auto pt-6"
    >
      {fa ? "مشاهده وب‌سایت ←" : "Visit website →"}
    </a>
  )}
</article>
