---
import MainLayout from "../layouts/MainLayout.astro";
import ScienceIcon from "./ScienceIcon.astro";
import { events, eventsFa } from "../data/events";
import { researchProjects, researchProjectsFa } from "../data/research";
import { awarenessArticles, awarenessArticlesFa } from "../data/awareness";

interface Props { lang?: "en" | "fa" }
const { lang = "en" } = Astro.props;
const fa = lang === "fa";
const prefix = fa ? "/fa" : "";
const t = (en: string, persian: string) => fa ? persian : en;
const currentEvents = (fa ? eventsFa : events).filter((item) => item.featured).slice(0, 2);
const currentResearch = (fa ? researchProjectsFa : researchProjects).filter((item) => item.featured).slice(0, 2);
const currentArticles = (fa ? awarenessArticlesFa : awarenessArticles).filter((item) => item.featured).slice(0, 3);

const audiences = [
  { n: "01", icon: "person", title: t("For the public", "برای عموم"), text: t("Understand common sleep concerns and find a responsible next step.", "مشکلات شایع خواب را بهتر بشناسید و گام بعدی مناسبی پیدا کنید."), href: `${prefix}/sleep-check`, color: "audience-card--public" },
  { n: "02", icon: "clinical", title: t("For professionals", "برای متخصصان"), text: t("Access education, events, clinical resources and a regional community.", "به آموزش، رویدادها، منابع بالینی و جامعه حرفه‌ای منطقه دسترسی پیدا کنید."), href: `${prefix}/events`, color: "audience-card--clinical" },
  { n: "03", icon: "research", title: t("For researchers & students", "برای پژوهشگران و دانشجویان"), text: t("Discover projects, collaborators and opportunities to move sleep science forward.", "پروژه‌ها، همکاران و فرصت‌های پیشبرد علم خواب را کشف کنید."), href: `${prefix}/research`, color: "audience-card--research" },
] as const;
const programs = [
  { icon: "research", title: t("Research network", "شبکه پژوهشی"), text: t("Connect regional questions with capable investigators and institutions.", "پرسش‌های منطقه‌ای را به پژوهشگران و مؤسسات توانمند پیوند می‌دهد."), href: `${prefix}/research` },
  { icon: "calendar", title: t("Learning & events", "آموزش و رویدادها"), text: t("Scientific meetings and practical learning for the whole sleep team.", "نشست‌های علمی و آموزش کاربردی برای تمام اعضای تیم خواب."), href: `${prefix}/events` },
  { icon: "book", title: t("Public sleep health", "سلامت خواب عمومی"), text: t("Clear, evidence-led information for people, families and communities.", "اطلاعات روشن و مبتنی بر شواهد برای افراد، خانواده‌ها و جامعه."), href: `${prefix}/awareness` },
  { icon: "network", title: t("Professional community", "جامعه حرفه‌ای"), text: t("A visible home for the people and organizations shaping sleep care.", "خانه‌ای برای افراد و سازمان‌هایی که مراقبت خواب را شکل می‌دهند."), href: `${prefix}/network` },
] as const;
---

<MainLayout lang={lang} title={t("KRISM — Khorasan Sleep Medicine", "KRISM — پزشکی خواب خراسان")} description={t("The regional hub for sleep medicine, research and public sleep health in Khorasan.", "مرکز منطقه‌ای پزشکی خواب، پژوهش و سلامت عمومی خواب در خراسان.")}>
  <section class="science-hero micro-grid relative overflow-hidden bg-krism-950 text-white">
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#68d7e8]/70 to-transparent"></div>
    <div class="absolute -start-32 -top-40 h-[34rem] w-[34rem] rounded-full bg-[#287789]/35 blur-3xl"></div>
    <div class="absolute -bottom-40 end-[-8rem] h-[30rem] w-[30rem] rounded-full bg-[#e67b67]/25 blur-3xl"></div>
    <div class="science-nodes pointer-events-none absolute inset-0 opacity-35" aria-hidden="true"></div>
    <div class="page-wrap relative grid min-h-[720px] gap-14 py-20 lg:grid-cols-[1.08fr_.92fr] lg:items-center lg:py-24">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-3 rounded-full border border-white/15 bg-white/5 px-4 py-2 font-mono text-xs font-semibold uppercase tracking-[.13em] text-white/80"><span class="status-beacon"></span>{t("Regional sleep science network", "شبکه منطقه‌ای علم خواب")}</div>
        <h1 class="mt-8 text-5xl font-medium leading-[.94] tracking-[-.052em] sm:text-6xl lg:text-[5.25rem]">{t("Sleep medicine,", "پزشکی خواب،")}<br /><em class="font-normal text-[#cbe8ee]">{t("connected.", "متصل و هم‌افزا.")}</em></h1>
        <p class="mt-8 max-w-2xl text-lg leading-9 text-white/70">{t("KRISM brings people, evidence and education together to strengthen sleep health across Khorasan—from scientific collaboration to a clearer first step for the public.", "KRISM افراد، شواهد و آموزش را برای تقویت سلامت خواب در خراسان به هم پیوند می‌دهد؛ از همکاری علمی تا یافتن نخستین گام روشن برای عموم.")}</p>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <a href={`${prefix}/sleep-check`} class="rounded-full bg-[#73d5df] px-7 py-4 text-center text-sm font-bold text-[#061923] shadow-[0_14px_35px_rgba(115,213,223,.18)] transition hover:-translate-y-0.5 hover:bg-white">{t("Should I see a sleep professional?", "آیا باید به متخصص خواب مراجعه کنم؟")}</a>
          <a href={`${prefix}/about`} class="rounded-full border border-white/25 px-7 py-4 text-center text-sm font-bold transition hover:bg-white/10">{t("Discover KRISM", "آشنایی با KRISM")}</a>
        </div>
        <div class="mt-12 grid max-w-2xl grid-cols-3 gap-4 border-t border-white/15 pt-7 font-mono text-xs uppercase tracking-[.12em] text-white/70"><span><b class="me-2 text-[#68d7e8]">01</b>{t("Regional", "منطقه‌ای")}</span><span><b class="me-2 text-[#68d7e8]">02</b>{t("Multidisciplinary", "چندرشته‌ای")}</span><span><b class="me-2 text-[#68d7e8]">03</b>{t("Bilingual", "دوزبانه")}</span></div>
      </div>
      <div class="glass-panel science-panel relative overflow-hidden rounded-[2rem] p-6 sm:p-8">
        <div class="flex items-center justify-between"><p class="font-mono text-xs font-bold uppercase tracking-[.16em] text-[#f6d46b]">KRISM / SLEEP_GUIDE_01</p><span class="rounded-full border border-[#68d7e8]/25 bg-[#68d7e8]/10 px-3 py-1.5 font-mono text-xs font-bold text-[#9de8f2]">{t("PRIVATE SESSION", "جلسه خصوصی")}</span></div>
        <div class="mt-8 rounded-[1.4rem] border border-white/12 bg-[#071d2a]/65 p-4">
          <div class="flex items-center justify-between font-mono text-xs uppercase tracking-[.12em] text-white/70"><span>{t("Sleep signal", "سیگنال خواب")}</span><span class="flex items-center gap-2"><span class="status-beacon"></span>{t("Ready", "آماده")}</span></div>
          <svg class="signal-graph mt-4 h-20 w-full text-[#68d7e8]" viewBox="0 0 520 100" preserveAspectRatio="none" aria-hidden="true"><path d="M0 55h54l9-2 8-30 11 68 13-84 14 48h58l10-2 9-25 12 61 14-78 14 44h57l10-1 9-31 11 69 14-87 13 50h65l9-2 9-25 12 61 15-78 13 44h29" fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" /></svg>
          <div class="mt-2 grid grid-cols-6 gap-1" aria-hidden="true">{[42,68,53,81,61,74].map((height) => (<span class="flex h-8 items-end rounded-sm bg-white/[.035]"><i class="block w-full rounded-sm bg-[#68d7e8]/35" style={`height:${height}%`}></i></span>))}</div>
        </div>
        <h2 class="mt-12 text-3xl font-medium leading-tight">{t("Not sure whether your sleep concern needs attention?", "مطمئن نیستید مشکل خوابتان نیاز به بررسی دارد؟")}</h2>
        <p class="mt-4 text-sm leading-7 text-white/65">{t("A short educational conversation organizes your symptoms into six recognized sleep-disorder areas and suggests a responsible next step.", "یک گفت‌وگوی آموزشی کوتاه علائم شما را در شش حوزه شناخته‌شده اختلالات خواب دسته‌بندی و گام بعدی مسئولانه را پیشنهاد می‌کند.")}</p>
        <div class="mt-7 grid grid-cols-3 gap-2 text-center font-mono text-xs font-semibold uppercase tracking-[.06em] text-white/75"><span class="rounded-xl border border-white/8 bg-white/[.04] px-2 py-3">{t("5–8 min", "۵ تا ۸ دقیقه")}</span><span class="rounded-xl border border-white/8 bg-white/[.04] px-2 py-3">{t("No account", "بدون حساب")}</span><span class="rounded-xl border border-white/8 bg-white/[.04] px-2 py-3">{t("No data saved", "بدون ذخیره داده")}</span></div>
        <a href={`${prefix}/sleep-check`} class="mt-7 flex items-center justify-between rounded-2xl bg-white px-5 py-4 text-sm font-bold text-krism-950 transition hover:bg-[#f6d46b]"><span>{t("Start my sleep check", "شروع ارزیابی خواب")}</span><span>{fa ? "←" : "→"}</span></a>
      </div>
    </div>
  </section>

  <section class="signal-strip"><div class="page-wrap flex flex-col gap-3 py-4 text-center font-mono text-xs font-bold uppercase tracking-[.1em] sm:flex-row sm:items-center sm:justify-between sm:text-start"><span class="flex items-center justify-center gap-3 sm:justify-start"><span class="status-beacon"></span>{t("Research · Education · Public health · Professional collaboration", "پژوهش · آموزش · سلامت عمومی · همکاری حرفه‌ای")}</span><span class="text-white/70">36.2605° N / 59.6168° E · {t("Khorasan, Iran", "خراسان، ایران")}</span></div></section>

  <section class="surface-mineral"><div class="page-wrap py-24 lg:py-32">
    <div class="grid gap-10 lg:grid-cols-[.7fr_1.3fr]"><p class="eyebrow h-fit text-krism-600">{t("Start where you are", "از نیاز خود شروع کنید")}</p><div><h2 class="max-w-4xl text-4xl font-medium leading-[1.02] tracking-[-.04em] text-krism-950 sm:text-5xl lg:text-6xl">{t("One society. Three clear ways in.", "یک جامعه علمی، سه مسیر روشن.")}</h2><p class="mt-6 max-w-2xl text-base leading-8 text-krism-muted">{t("The website adapts to what you need—practical guidance, professional learning or scientific collaboration.", "این وب‌سایت با نیاز شما هماهنگ می‌شود؛ راهنمایی کاربردی، یادگیری حرفه‌ای یا همکاری علمی.")}</p></div></div>
    <div class="mt-14 grid gap-5 lg:grid-cols-3">{audiences.map((item) => (<a href={item.href} class:list={["audience-card lift-link group flex min-h-[21rem] flex-col overflow-hidden rounded-[1.65rem] p-7", item.color]}><div class="relative flex items-center justify-between"><span class="font-mono text-xs font-bold text-white/70">PATH / {item.n}</span><span class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/15 text-[#73d5df] transition group-hover:border-[#73d5df]/50 group-hover:bg-[#73d5df]/10">↗</span></div><div class="relative mt-9"><span class="icon-badge h-16 w-16"><ScienceIcon name={item.icon} class="h-8 w-8" /></span></div><div class="relative mt-auto"><h3 class="text-3xl font-medium">{item.title}</h3><p class="mt-4 text-sm leading-7">{item.text}</p></div></a>))}</div>
  </div></section>

  <section class="surface-night text-white"><div class="page-wrap py-24 lg:py-32">
    <div class="grid gap-14 lg:grid-cols-[.92fr_1.08fr] lg:items-end"><div><p class="eyebrow text-[#73d5df]">{t("A working society", "جامعه‌ای فعال")}</p><h2 class="mt-6 text-4xl font-medium leading-[1.02] tracking-[-.04em] text-white sm:text-5xl">{t("Built around programs, not pages.", "برنامه‌محور، نه صرفاً صفحه‌محور.")}</h2></div><p class="max-w-xl text-base leading-8 text-white/58">{t("KRISM turns regional expertise into practical programs that people can join, use and help shape.", "KRISM تخصص منطقه‌ای را به برنامه‌های کاربردی تبدیل می‌کند که می‌توان در آن‌ها مشارکت کرد و در شکل‌گیری‌شان نقش داشت.")}</p></div>
    <div class="mt-14 divide-y divide-white/10 border-y border-white/10">{programs.map((item, index) => (<a href={item.href} class="program-row group grid gap-4 py-7 md:grid-cols-[3rem_4rem_.7fr_1.3fr_auto] md:items-center"><span class="font-mono text-[10px] font-bold text-[#73d5df]">0{index + 1}</span><span class="icon-badge"><ScienceIcon name={item.icon} class="h-6 w-6" /></span><h3 class="text-2xl font-medium text-white">{item.title}</h3><p class="text-sm leading-7 text-white/55">{item.text}</p><span class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/12 text-[#73d5df] transition group-hover:border-[#73d5df]/45 group-hover:bg-[#73d5df]/10">{fa ? "←" : "→"}</span></a>))}</div>
  </div></section>

  <section class="bg-krism-950 text-white"><div class="page-wrap py-24 lg:py-32">
    <div class="flex flex-col justify-between gap-7 lg:flex-row lg:items-end"><div><p class="eyebrow text-[#f6d46b]">{t("Now at KRISM", "اکنون در KRISM")}</p><h2 class="mt-6 max-w-3xl text-4xl font-medium leading-[1.02] sm:text-5xl">{t("Current work, visible and connected.", "فعالیت‌های جاری، شفاف و به‌هم‌پیوسته.")}</h2></div><a href={`${prefix}/research`} class="w-fit text-sm font-bold text-[#cbe8ee]">{t("Explore all research", "مشاهده همه پژوهش‌ها")} {fa ? "←" : "→"}</a></div>
    <div class="mt-12 grid gap-4 lg:grid-cols-2">{currentResearch.map((project) => (<a href={`${prefix}/research/${project.slug}`} class="lift-link science-panel overflow-hidden rounded-[2rem] border border-white/15 bg-white/5 p-8"><div class="flex items-center justify-between"><p class="text-xs font-bold uppercase tracking-[.14em] text-[#f6d46b]">{project.type}</p><span class="flex h-12 w-12 items-center justify-center rounded-2xl border border-white/12 bg-white/5 text-[#68d7e8]"><ScienceIcon name="research" class="h-6 w-6" /></span></div><h3 class="mt-12 text-3xl font-medium">{project.title}</h3><p class="mt-4 text-sm leading-7 text-white/60">{project.description}</p><p class="mt-7 text-sm font-bold text-[#cbe8ee]">{t("View project", "مشاهده پروژه")} {fa ? "←" : "→"}</p></a>))}</div>
    <div class="mt-4 grid gap-4 lg:grid-cols-[.8fr_1.2fr]"><div class="rounded-[2rem] bg-[#e67b67] p-8"><p class="text-xs font-bold uppercase tracking-[.14em]">{t("Next opportunities", "فرصت‌های پیش‌رو")}</p><h3 class="mt-10 text-3xl font-medium">{t("Learn together. Meet the field.", "با هم بیاموزیم و با جامعه علمی همراه شویم.")}</h3><a href={`${prefix}/events`} class="mt-8 inline-flex rounded-full bg-white px-5 py-3 text-sm font-bold text-krism-950">{t("View events", "مشاهده رویدادها")}</a></div><div class="divide-y divide-white/15 rounded-[2rem] border border-white/15 px-7">{currentEvents.map((event) => (<a href={`${prefix}/events/${event.slug}`} class="grid gap-3 py-6 sm:grid-cols-[8rem_1fr] sm:items-center"><span class="text-xs font-bold text-[#f6d46b]">{event.date}</span><div><h3 class="text-xl font-medium">{event.title}</h3><p class="mt-1 text-xs text-white/50">{event.location}</p></div></a>))}</div></div>
  </div></section>

  <section class="surface-teal text-white"><div class="page-wrap py-24 lg:py-32"><div class="grid gap-12 lg:grid-cols-[.65fr_1.35fr]"><div><span class="icon-badge h-16 w-16"><ScienceIcon name="book" class="h-8 w-8" /></span><p class="eyebrow mt-8 text-[#73d5df]">{t("Public sleep health", "سلامت عمومی خواب")}</p><h2 class="mt-6 text-4xl font-medium leading-tight text-white">{t("Clear knowledge for better decisions.", "دانش روشن برای تصمیم‌های بهتر.")}</h2><a href={`${prefix}/awareness`} class="mt-8 inline-flex text-sm font-bold text-[#b6eef0]">{t("Browse the sleep library", "مرور کتابخانه خواب")} {fa ? "←" : "→"}</a></div><div class="grid gap-4 md:grid-cols-3">{currentArticles.map((article, index) => (<a href={`${prefix}/awareness/${article.slug}`} class="editorial-card lift-link flex min-h-[19rem] flex-col overflow-hidden rounded-[1.35rem] p-6"><div class="flex items-center justify-between"><p class="text-xs font-bold text-[#73d5df]">{article.category}</p><span class="icon-badge h-11 w-11"><ScienceIcon name={index === 0 ? "moon" : index === 1 ? "clock" : "clinical"} class="h-5 w-5" /></span></div><div class="mt-auto"><h3 class="text-2xl font-medium leading-tight">{article.title}</h3><p class="mt-4 line-clamp-3 text-sm leading-6">{article.excerpt}</p></div></a>))}</div></div></div></section>

  <section class="surface-mineral"><div class="page-wrap py-24 lg:py-32"><div class="science-illustration relative overflow-hidden px-6 py-20 text-center sm:px-12"><div class="absolute -start-16 -top-16 h-52 w-52 rounded-full border border-[#73d5df]/15"></div><div class="absolute -bottom-24 -end-16 h-64 w-64 rounded-full border border-[#73d5df]/15"></div><span class="icon-badge mx-auto h-20 w-20"><ScienceIcon name="network" class="h-10 w-10" /></span><p class="eyebrow mt-9 justify-center text-[#73d5df]">{t("Build it with us", "با ما همراه شوید")}</p><h2 class="mx-auto mt-7 max-w-4xl text-5xl font-medium leading-[.98] tracking-[-.045em] text-white sm:text-6xl">{t("A stronger sleep-medicine community starts with connection.", "جامعه قوی‌تر پزشکی خواب از ارتباط آغاز می‌شود.")}</h2><div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row"><a href={`${prefix}/network`} class="rounded-full bg-[#73d5df] px-7 py-4 text-sm font-bold text-[#061923]">{t("Explore the network", "مشاهده شبکه")}</a><a href={`${prefix}/contact`} class="rounded-full border border-white/18 bg-white/[.055] px-7 py-4 text-sm font-bold text-white">{t("Contact KRISM", "تماس با KRISM")}</a></div></div></div></section>
</MainLayout>
