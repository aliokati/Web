---
import type { ResourceItem } from "../data/resources";

interface Props {
  resource: ResourceItem;
}

const { resource } = Astro.props;
---

<article
  class="soft-card p-7 transition duration-300 hover:-translate-y-1"
>
  <p class="text-xs font-semibold uppercase tracking-[0.15em] text-krism-600">
    {resource.category}
  </p>

  <h2 class="mt-5 text-2xl font-medium leading-tight text-krism-950">
    {resource.title}
  </h2>

  <p class="mt-3 text-sm leading-7 text-krism-muted">
    {resource.description}
  </p>

  {
    resource.url ? (
      <a
        href={resource.url}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-block text-sm font-semibold text-krism-600 hover:text-krism-900"
      >
        Open resource →
      </a>
    ) : (
      <span class="mt-6 inline-block text-sm font-medium text-krism-muted">
        Coming soon
      </span>
    )
  }
</article>
