# Copy to .env.local and set the mailbox password privately.
KRISM_SMTP_HOST=mail.krism-society.com
KRISM_SMTP_PORT=465
KRISM_SMTP_USER=info@krism-society.com
KRISM_SMTP_PASSWORD=
# Optional: public site origin when deploying behind a reverse proxy.
# KRISM_SITE_URL=https://krism-society.com

# Optional: durable private storage path for the owner account and editable content.
# Default: data/cms under the project. Keep this folder when deploying/restarting.
# KRISM_CMS_DATA_DIR=/absolute/path/to/private-cms-data
